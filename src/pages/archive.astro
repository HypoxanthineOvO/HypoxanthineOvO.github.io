---
import BaseLayout from '../layouts/BaseLayout.astro';
import GateHead from '../components/GateHead.astro';
import { getArchiveItems } from '../lib/content';

const items = await getArchiveItems();
const byYear = new Map<number, typeof items>();
for (const item of items) {
  const year = typeof item.date === 'string' ? Number(item.date.slice(0, 4)) : item.date.getUTCFullYear();
  const bucket = byYear.get(year) ?? [];
  bucket.push(item);
  byYear.set(year, bucket);
}
const years = [...byYear.entries()].sort((a, b) => b[0] - a[0]);
const gateAccent: Record<string, string> = {
  research: '#3d7a93', work: '#2f9e6e', essays: '#9e2b25', poetry: '#8a5a2b',
  publish: '#b3541e', notes: '#3f6d9e', study: '#4a6b4f',
};
const fmtDate = (d: Date | string) => (typeof d === 'string' ? d : d.toISOString().slice(0, 10));
---

<BaseLayout skin="archive" title="档案">
  <section class="skin">
    <div class="shell">
      <GateHead kicker="档案 / ARCHIVE" title="总档案" blurb={'全站按时间倒序的一条时间线，服务"我自己回看"的场景。'} note={`${items.length} 条`} />
      <div class="searchbar">
        <input
          id="archiveSearch"
          type="search"
          placeholder="搜索标题 / 描述 / 课程 / 栏目…"
          autocomplete="off"
          aria-label="搜索档案"
        />
        <span class="count" id="archiveCount">{items.length} 条</span>
      </div>
      <div class="timeline" id="archiveTimeline">
        {years.map(([year, yearItems]) => (
          <div class="year">
            <div class="rail">{year}</div>
            <div class="rows">
              {yearItems.map((item) => (
                <a
                  class="row"
                  href={item.href}
                  data-search={`${item.title} ${item.description ?? ''} ${item.extra ?? ''} ${item.gateName}`.toLowerCase()}
                >
                  <span class="date">{fmtDate(item.date)}</span>
                  <span class="gate-chip" style={`--chip: ${gateAccent[item.gate] ?? '#6e6e66'}`}>{item.gateName}</span>
                  <span class="title">{item.title}</span>
                  {item.extra && <span class="extra">{item.extra}</span>}
                </a>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <script>
    // 客户端过滤：匹配标题/描述/栏目的子串，空年份分组整组隐藏
    const input = document.getElementById('archiveSearch') as HTMLInputElement | null;
    const count = document.getElementById('archiveCount');
    const timeline = document.getElementById('archiveTimeline');
    if (input && timeline) {
      const rows = [...timeline.querySelectorAll<HTMLElement>('.row')];
      const total = rows.length;
      input.addEventListener('input', () => {
        const q = input.value.trim().toLowerCase();
        let shown = 0;
        for (const row of rows) {
          const hit = !q || (row.dataset.search ?? '').includes(q);
          row.style.display = hit ? '' : 'none';
          if (hit) shown++;
        }
        for (const year of timeline.querySelectorAll<HTMLElement>('.year')) {
          const visible = [...year.querySelectorAll<HTMLElement>('.row')].some((r) => r.style.display !== 'none');
          year.style.display = visible ? '' : 'none';
        }
        if (count) count.textContent = q ? `${shown} / ${total} 条` : `${total} 条`;
      });
    }
  </script>
</BaseLayout>

<style>
  .searchbar { display: flex; align-items: center; gap: 14px; padding: 22px 0 6px; }
  .searchbar input {
    flex: 1; max-width: 420px; font-family: var(--font-ui); font-size: 14px;
    color: var(--fg); background: var(--panel); border: 1px solid var(--line);
    border-radius: 999px; padding: 8px 18px; outline: none;
  }
  .searchbar input:focus { border-color: var(--muted); }
  .searchbar .count { font-family: var(--font-mono); font-size: 11.5px; color: var(--muted); }
  .timeline { padding: 20px 0 64px; display: flex; flex-direction: column; gap: 10px; }
  .year { display: grid; grid-template-columns: 64px 1fr; gap: 0 26px; }
  .rail { font-family: var(--font-mono); font-size: 13px; color: var(--muted); position: sticky; top: 76px; align-self: start; padding-top: 6px; }
  .rows { display: flex; flex-direction: column; }
  .row {
    display: grid; grid-template-columns: 88px 64px 1fr auto; gap: 14px; align-items: baseline;
    padding: 8px 6px; border-bottom: 1px solid color-mix(in srgb, var(--line) 70%, transparent);
    font-size: 13.5px;
  }
  .row:hover .title { text-decoration: underline; text-underline-offset: 4px; }
  .row .date { font-family: var(--font-mono); font-size: 12px; color: var(--muted); }
  .gate-chip {
    font-size: 10.5px; color: var(--chip); border: 1px solid color-mix(in srgb, var(--chip) 45%, transparent);
    border-radius: 2px; padding: 0 7px; text-align: center; line-height: 1.7;
  }
  .row .title { line-height: 1.6; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .row .extra { font-size: 11.5px; color: var(--muted); max-width: 18em; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  @media (max-width: 960px) {
    .year { grid-template-columns: 1fr; }
    .rail { position: static; padding: 14px 0 0; }
    .row { grid-template-columns: 84px 1fr; }
    .row .title { grid-column: 1 / -1; white-space: normal; }
    .row .extra { display: none; }
  }
</style>
