---
import { ArrowRight, ArrowUpRight, CalendarDays, Newspaper, Radio } from '@lucide/astro';
import { getCollection } from 'astro:content';
import dailyIssues from '../../data/wechat-daily.json';
import BaseLayout from '../../layouts/BaseLayout.astro';

const articles = (await getCollection('wechat')).sort((a,b) => b.data.date.valueOf() - a.data.date.valueOf());
const latest = dailyIssues[0];
const totalItems = dailyIssues.reduce((sum, issue) => sum + issue.items.length, 0);
---
<BaseLayout title="公众号" description="Hypoxanthine 的公众号科学写作、AI 日报、工程笔记与系列文章。" image={latest.cover ?? '/media/projects/ai-daily.webp'}>
  <header class="inner-hero wechat-hero"><div class="page-shell"><p class="instrument-label instrument-label--dark">WECHAT / SCIENCE WRITING</p><h1>公众号写作，不是一条混合的信息流。</h1><p>科学与技术长文独立成篇，教程按系列组织；AI 日报则以每天一份 issue 的形式归档，每个日期页内部保留当天全部新闻卡片。</p><div class="channel-stats"><span><Radio size={18} /> 公众号一级栏目</span><span><CalendarDays size={18} /> {dailyIssues.length} 期日报</span><span><Newspaper size={18} /> {totalItems} 条新闻</span></div></div></header>
  <section class="content-band content-band--ink"><div class="page-shell"><div class="section-intro section-intro--inverse"><div><p class="instrument-label">LATEST ISSUE / {latest.date}</p><h2>{latest.title}</h2></div><a class="text-link" href="/wechat/daily">浏览全部日报<ArrowUpRight size={17} /></a></div><a class="daily-issue-feature" href={`/wechat/daily/${latest.date}`}><img src={latest.cover ?? '/media/projects/ai-daily.webp'} alt="" width="1536" height="864" /><div><p>{latest.summary}</p><span>{latest.items.length} 条新闻卡片 <ArrowRight size={17} /></span></div></a></div></section>
  <section class="inner-section"><div class="page-shell"><div class="section-intro"><div><p class="instrument-label instrument-label--dark">LONGFORM / SERIES</p><h2>科学写作与系列文章</h2></div></div><div class="wechat-grid">{articles.map((entry) => <a class="wechat-article-card" href={`/wechat/articles/${entry.id}`}>{entry.data.cover && <img src={entry.data.cover} alt="" width="1600" height="900" loading="lazy" />}<div><span>{entry.data.series} / {entry.data.status === 'published' ? '已发布' : '写作档案'}</span><h2>{entry.data.title}</h2><p>{entry.data.description}</p></div></a>)}</div></div></section>
  <section class="content-band content-band--signal"><div class="page-shell channel-map"><p class="instrument-label instrument-label--dark">CONTENT MAP</p><h2>按内容本身选择页面形态。</h2><div><article><span>01</span><h3>AI 日报</h3><p>按日期进入独立 issue，每期内部是一组完整新闻卡片。</p><a href="/wechat/daily">日报索引 <ArrowUpRight size={16} /></a></article><article><span>02</span><h3>研究与工程笔记</h3><p>保留问题、方法、图像与工程细节的独立长文。</p></article><article><span>03</span><h3>教程与项目复盘</h3><p>按系列组织，文章之间保留清晰顺序与上下文。</p></article></div></div></section>
</BaseLayout>
