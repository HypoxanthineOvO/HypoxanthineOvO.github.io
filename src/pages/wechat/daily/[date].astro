---
import { ArrowLeft, ArrowUpRight } from '@lucide/astro';
import dailyIssues from '../../../data/wechat-daily.json';
import BaseLayout from '../../../layouts/BaseLayout.astro';

export function getStaticPaths() {
  return dailyIssues.map((issue) => ({ params: { date: issue.date }, props: { issue } }));
}
const { issue } = Astro.props;
---
<BaseLayout title={issue.title} description={issue.summary} image={issue.cover ?? '/media/projects/ai-daily.webp'}>
  <header class="issue-header"><div class="page-shell"><a class="text-link text-link--dark" href="/wechat/daily"><ArrowLeft size={16} /> 返回日报索引</a><p class="instrument-label instrument-label--dark mt-8">AI DAILY / {issue.date}</p><h1>{issue.title}</h1><p class="lead-copy mt-6 max-w-3xl">{issue.summary}</p><div class="issue-header__meta"><span>{issue.items.length} NEWS ITEMS</span><span>{issue.published ? '公众号已发布' : 'HYPO-WRITER 写作档案'}</span><span>ASIA/SHANGHAI</span></div></div></header>
  <section class="inner-section"><div class="page-shell"><div class="news-grid">{issue.items.map((item) => <article class="news-card"><div class="news-card__top"><span>#{String(item.number).padStart(2,'0')}</span><span>{item.category}</span></div><h2>{item.title}</h2><p class="news-card__body">{item.body}</p><footer><span>{item.source ?? '来源见原稿'}</span>{item.url && <a href={item.url} target="_blank" rel="noreferrer">原文 <ArrowUpRight size={14} /></a>}</footer></article>)}</div></div></section>
</BaseLayout>
