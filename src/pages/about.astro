---
import BaseLayout from '../layouts/BaseLayout.astro';
import GateHead from '../components/GateHead.astro';
import { siteConfig, platforms } from '../lib/site';
import { getPublications } from '../lib/content';
import { facets } from '../data/home';

const pubs = await getPublications();
---

<BaseLayout title="关于" description={`${siteConfig.brand} · ${siteConfig.brandEn}，${siteConfig.affil}博士在读，研究 77 K 低温 GPU 与神经渲染，深度研究 AI Agent 与各类模型。`}>
  <div class="shell">
    <GateHead kicker="ABOUT" title="关于" />
    <div class="about">
      <div class="card main rv">
        <p class="names">{siteConfig.brand} · {siteConfig.brandEn}</p>
        <p class="lead">{siteConfig.brand} · {siteConfig.brandEn}，{siteConfig.affil}博士在读。<mark>2022 年 8 月、大二起加入课题组</mark>，至今没有离开过。</p>
        <p>日常是两种身份的叠加：白天做<b>硬件架构科研</b>，其余时间做<b>高阶 AI 实践</b>。科研上有两条时间线——从大二持续至今的<b>神经渲染线</b>（软硬件协同设计、Instant-NGP 周期级 C-Model、{pubs.length} 篇论文，以及 AI 辅助的场景复杂性理论支线），和 2025 年底分叉开启的 <b>77 K 低温 GPU 线</b>（液氮温区的架构设计空间、Cryo-Model 器件映射与 VSP GPU 模拟器）。</p>
        <p>AI 方面不止于「用 AI 写代码」：我花大量时间研究 <b>Agent 的实现细节</b>，体验和评测各家模型的脾气秉性，并动手改造 AI 本身——自研 <b>VSPi</b> Agent 底座、<b>Hypo-Workflow</b> 断点续传工作流、<b>HypoDoc</b> 排版 Skill 与 <b>Hypo-Expression</b> 自然表达扩展；再用这套体系造出 <b>Hypo-Info</b> 信息引擎、<b>Hypo-Class</b> 课堂助教，以及 <b>HypoMC</b> 生存整合包与<b>盘龙</b>魔法模组等游戏产品。</p>
        <p>这些经验会整理成视频和文章，发在「{siteConfig.brand} · {siteConfig.brandEn}」各平台账号：讲透 AI 圈的事，也把做出来的东西公开给大家用。</p>
        <div class="facets">
          {facets.map((f) => <span><b>{f.title}</b>{f.text}</span>)}
        </div>
      </div>
      <aside class="side rv">
        <img src={siteConfig.avatar} alt="Q 版的我和七个 AI" width="900" height="900" />
        <div class="card contact">
          <h2>联系</h2>
          <a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>
          {platforms.map((p) => p.href
            ? <a href={p.href} rel="noreferrer">{p.label}{p.handle ? ` · ${p.handle}` : ''} ↗</a>
            : <span>{p.label} · {p.handle}</span>)}
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>

<style>
  .about { display: grid; grid-template-columns: 1fr 340px; gap: 24px; align-items: start; padding-bottom: 20px; }
  .main { padding: 32px 34px; }
  .names { font-size: 12.5px; color: var(--muted); }
  .lead { font-family: var(--font-serif); font-weight: 700; font-size: 22px; line-height: 1.7; margin: 14px 0 14px; }
  .lead mark { background: linear-gradient(transparent 58%, var(--red-soft) 58%); color: inherit; padding: 0 2px; }
  .main p:not(.lead):not(.names) { font-size: 15.5px; line-height: 1.95; color: var(--ink-2); margin-bottom: 10px; }
  .main b { color: var(--fg); font-weight: 500; }
  .facets { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-top: 18px; }
  .facets span { font-size: 13.5px; line-height: 1.6; color: var(--ink-2); padding: 12px 14px; border-radius: 10px; background: var(--paper-2); }
  .facets b { display: block; font-family: var(--font-serif); font-weight: 900; font-size: 15px; color: var(--fg); margin-bottom: 2px; }
  .side img { width: 100%; height: auto; border-radius: 50%; background: #fffdf8; }
  .contact { margin-top: 16px; padding: 20px 22px; display: flex; flex-direction: column; gap: 9px; font-size: 14px; }
  .contact h2 { font-family: var(--font-serif); font-weight: 900; font-size: 17px; margin-bottom: 4px; }
  .contact a { width: fit-content; border-bottom: 1px solid var(--line); }
  .contact a:hover { color: var(--red); border-color: var(--red); }
  .contact span { color: var(--ink-2); }
  @media (max-width: 900px) {
    .about { grid-template-columns: 1fr; }
    .side { max-width: 360px; }
  }
</style>
