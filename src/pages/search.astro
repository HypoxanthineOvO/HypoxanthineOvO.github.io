---
import { ArrowUpRight, Search as SearchIcon } from '@lucide/astro';
import { getCollection } from 'astro:content';
import dailyIssues from '../data/wechat-daily.json';
import { projects } from '../data/portfolio';
import BaseLayout from '../layouts/BaseLayout.astro';

const [posts, notes, publications, wechat] = await Promise.all([getCollection('posts'), getCollection('notes'), getCollection('publications'), getCollection('wechat')]);
const results = [
  ...projects.map((item) => ({ title: item.name, type: '项目', href: item.url ?? '/work', text: `${item.description.zh} ${item.description.en} ${item.tech.join(' ')}` })),
  ...publications.map((item) => ({ title: item.data.title, type: '发表', href: `/publications/${item.id}`, text: `${item.data.authors?.join(' ') ?? ''} ${item.data.venue ?? ''}` })),
  ...wechat.map((item) => ({ title: item.data.title, type: '公众号', href: `/wechat/articles/${item.id}`, text: `${item.data.description} ${item.data.series}` })),
  ...dailyIssues.map((item) => ({ title: item.title, type: 'AI 日报', href: `/wechat/daily/${item.date}`, text: `${item.summary} ${item.items.map((news) => news.title).join(' ')}` })),
  ...posts.map((item) => ({ title: item.data.title, type: '文章', href: `/posts/${item.id}`, text: `${item.data.description ?? ''} ${item.data.tags.join(' ')}` })),
  ...notes.map((item) => ({ title: item.data.title, type: '笔记', href: `/notes/${item.id}`, text: `${item.data.description ?? ''} ${item.data.tags.join(' ')}` })),
];
---
<BaseLayout title="搜索" description="搜索 Hypoxanthine 的项目、研究、公众号、日报、文章与笔记。">
  <header class="inner-hero"><div class="page-shell"><p class="instrument-label instrument-label--dark">SEARCH / INDEX</p><h1>搜索全部公开档案。</h1><p>项目、研究发表、公众号文章、98 期日报、旧文章与技术笔记使用同一个前端索引。</p></div></header>
  <section class="inner-section"><div class="page-shell"><label class="search-page-input"><SearchIcon size={22} aria-hidden="true" /><span class="sr-only">搜索</span><input class="search-input" type="search" placeholder="输入项目、主题、技术或日期" autofocus data-global-search /></label><p class="search-count" aria-live="polite" data-search-count>{results.length} 项</p><div class="index-list" data-search-results>{results.map((result) => <a class="index-row" href={result.href} data-search-item data-haystack={`${result.title} ${result.type} ${result.text}`}><span>{result.type}</span><div><h2>{result.title}</h2></div><div><p>{result.text}</p></div><ArrowUpRight size={19} /></a>)}</div></div></section>
</BaseLayout>
<script>
  const input = document.querySelector<HTMLInputElement>('[data-global-search]');
  const count = document.querySelector<HTMLElement>('[data-search-count]');
  const items = [...document.querySelectorAll<HTMLElement>('[data-search-item]')];
  const apply = () => { const query = input?.value.trim().toLocaleLowerCase() ?? ''; let visible = 0; items.forEach((item) => { item.hidden = Boolean(query) && !item.dataset.haystack?.toLocaleLowerCase().includes(query); if (!item.hidden) visible += 1; }); if (count) count.textContent = `${visible} 项`; };
  input?.addEventListener('input', apply);
</script>
