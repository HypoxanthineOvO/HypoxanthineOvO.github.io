---
import BaseLayout from '../layouts/BaseLayout.astro';
import GateHead from '../components/GateHead.astro';
import { getFeaturedProjects } from '../lib/content';

const projects = await getFeaturedProjects();
const statusDot = { active: 'green', wip: 'yellow', archived: 'gray' } as const;
const catLabel = { research: 'RESEARCH', systems: 'SYSTEMS', writing: 'WRITING', tools: 'TOOLS' } as const;
---

<BaseLayout skin="engineering" title="项目">
  <section class="skin">
    <div class="shell">
      <GateHead
        gate="work"
        blurb="主线之外长期维护的东西，多数与 AI 与 Agent 有关：每天在用的工具，和为把它们串起来而造的系统。只陈列精选，其余进档案。"
        note="SELECTED"
      />
      <div class="bignets">
        {projects.map((p) => (
          <a class="bignet" href={`/work/${p.id}`}>
            <div class:list={['cover', p.data.cover ? 'img' : 'ph']} style={p.data.cover ? `background-image:url('${p.data.cover}')` : undefined}>
              <span class="badge">{p.data.category ? catLabel[p.data.category] : 'PROJECT'}</span>
              {!p.data.cover && <span class="mono">{p.data.name}</span>}
            </div>
            <div class="body">
              <h3>{p.data.name} <i class:list={['dot', `dot--${statusDot[p.data.status]}`]} /></h3>
              <p class="desc">{p.data.description}</p>
              <div class="meta">
                <span class="note">{p.data.statusNote ?? (p.data.status === 'wip' ? '进行中' : p.data.status === 'archived' ? '已归档' : '活跃维护')}</span>
                <span class="arrow">-&gt;</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .bignets { padding: 26px 0 64px; display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .bignet {
    position: relative; border-radius: 8px; overflow: hidden; background: var(--panel);
    border: 1px solid var(--skin-line); display: flex; flex-direction: column;
    transition: transform .22s ease, box-shadow .22s ease;
  }
  .bignet:hover { transform: translateY(-5px); box-shadow: 0 18px 44px rgba(10,40,25,.14); }
  .cover { aspect-ratio: 16 / 9; display: flex; align-items: center; justify-content: center; position: relative; }
  .cover.img { background-size: cover; background-position: center; }
  .cover.ph {
    background: linear-gradient(150deg, #0d1117 0%, #12261c 60%, #1c3a2a 100%);
    color: #7ee787; font-family: var(--font-mono); font-size: 22px; letter-spacing: .12em;
  }
  .badge {
    position: absolute; top: 10px; left: 10px; font-family: var(--font-mono); font-size: 10.5px;
    background: rgba(13,17,23,.78); color: #d2f8e4; padding: 2px 9px; border-radius: 3px; backdrop-filter: blur(3px);
  }
  .body { padding: 14px 16px 15px; display: flex; flex-direction: column; gap: 6px; flex: 1; }
  h3 { font-size: 17.5px; font-weight: 700; display: flex; align-items: center; gap: 8px; }
  .desc { font-size: 13px; color: var(--skin-muted); line-height: 1.65; }
  .meta {
    margin-top: auto; padding-top: 10px; border-top: 1px dashed var(--skin-line);
    display: flex; align-items: center; gap: 8px; font-size: 12px; color: var(--skin-muted); font-family: var(--font-mono);
  }
  .meta .note { color: var(--fg); font-family: var(--font-ui); }
  .meta .arrow { margin-left: auto; color: var(--gate); }
  .dot { width: 8px; height: 8px; border-radius: 50%; flex: none; }
  .dot--green { background: #3fb950; box-shadow: 0 0 8px rgba(63,185,80,.55); }
  .dot--yellow { background: #d29922; box-shadow: 0 0 8px rgba(210,153,34,.55); }
  .dot--gray { background: #8b949e; }
  @media (max-width: 960px) { .bignets { grid-template-columns: 1fr; } }
</style>
