---
import { render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { getNotes, formatDate, getAdjacentEntries } from '../../lib/content';

export async function getStaticPaths() {
  const notes = await getNotes();
  return notes.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const notes = await getNotes();
const { newer, older } = getAdjacentEntries(notes, entry.id);
const metas = [formatDate(entry.data.date)];
if (entry.data.source) metas.push(entry.data.source);
if (entry.data.link) metas.push('原文');
---

<ArticleLayout skin="notes" kicker="技术笔记" title={entry.data.title} metas={metas} description={entry.data.description}>
  {entry.data.link && (
    <p class="source-line">来源：<a href={entry.data.link} target="_blank" rel="noreferrer">{entry.data.source ?? entry.data.link}</a></p>
  )}
  <Content />
  <nav class="adj">
    {older && <a href={`/notes/${older.id}`}>← {older.data.title}</a>}
    {newer && <a href={`/notes/${newer.id}`}>{newer.data.title} →</a>}
  </nav>
</ArticleLayout>

<style>
  .source-line { font-size: 13px; color: var(--skin-muted); margin-bottom: 1.4em; }
  .source-line a { color: var(--gate); }
  .adj {
    margin-top: 3em; padding-top: 1.2em; border-top: 1px solid var(--skin-line);
    display: flex; justify-content: space-between; gap: 18px; font-size: 13.5px; flex-wrap: wrap;
  }
  .adj a { color: var(--skin-muted); }
  .adj a:hover { color: var(--gate); }
</style>
