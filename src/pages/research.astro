---
import BaseLayout from '../layouts/BaseLayout.astro';
import GateHead from '../components/GateHead.astro';
import ResearchTimeline from '../components/ResearchTimeline.astro';
---

<BaseLayout skin="research" title="研究" description="从神经渲染加速器到低温 GPU 架构。">
  <section class="skin">
    <div class="shell">
      <GateHead
        gate="research"
        title="研究"
        blurb="从神经渲染加速器到低温 GPU 架构。"
      />
      <div class="research-history">
        <ResearchTimeline detailed />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .research-history { margin-top: 22px; margin-bottom: 64px; }
</style>
