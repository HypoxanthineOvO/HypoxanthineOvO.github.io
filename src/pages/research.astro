---
import BaseLayout from '../layouts/BaseLayout.astro';
import GateHead from '../components/GateHead.astro';
import ResearchTimeline from '../components/ResearchTimeline.astro';
import { getPublications, groupBy } from '../lib/content';

const pubs = await getPublications();
const byYear = groupBy(pubs, (p) => String(p.data.year));
const firstAuthor = (authors?: string[]) => authors?.[0] === 'Yunxiang He';
const firstCount = pubs.filter((p) => firstAuthor(p.data.authors)).length;
---

<BaseLayout skin="research" title="研究 · 双轨时间线与学术发表" description="神经渲染加速器与表示复杂性、77 K 低温 GPU 架构与周期级模拟器：两条科研线的演化时间轴与 8 篇学术论文。">
  <section class="skin">
    <div class="shell">
      <GateHead
        gate="research"
        title="研究"
        note="TWO TRACKS"
        blurb="2022 年 8 月（大二）进组后，科研从神经渲染加速器出发，在 2025 年底 / 2026 年初分叉出 77 K 低温 GPU 主线，神经渲染则延伸出表示复杂性的理论支线。"
      />
      <div class="tl-wrap"><ResearchTimeline papers={false} /></div>

      <div class="wall-head">
        <h2>学术发表</h2>
        <span>{pubs.length} 篇论文 · {firstCount} 篇一作 · 神经渲染线</span>
      </div>
      <div class="wall">
        {byYear.map(({ key: year, items }) => (
          <div class="yearrow">
            <div class="rail">{year}</div>
            <div class="cards">
              {items.map((p) => (
                <a class:list={['paper-card', { 'first-author': firstAuthor(p.data.authors) }]} href={`/research/${p.id}`}>
                  <span class="venue">{p.data.venue}</span>
                  <h3>{p.data.title}</h3>
                  <span class="authors">
                    {(p.data.authors ?? []).map((a, i) => (
                      <>{i > 0 && '，'}{a === 'Yunxiang He' ? <b>{a}</b> : a}</>
                    ))}
                  </span>
                  <span class="row">
                    {p.data.pdf && <span class="lnk">PDF</span>}
                    {p.data.code && <span class="lnk">CODE</span>}
                    <span class="spark">{firstAuthor(p.data.authors) ? '一作' : '合作'}</span>
                  </span>
                </a>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .tl-wrap { margin-top: 16px; }
  .wall-head { display: flex; align-items: baseline; gap: 14px; margin-top: 56px; padding-bottom: 10px; border-bottom: 1.5px solid var(--fg); }
  .wall-head h2 { font-family: var(--font-serif); font-weight: 900; font-size: 26px; }
  .wall-head span { font-size: 13px; color: var(--skin-muted); }
  .wall { padding: 22px 0 64px; display: flex; flex-direction: column; gap: 8px; }
  .yearrow { display: grid; grid-template-columns: 64px minmax(0, 1fr); gap: 0 26px; }
  .rail {
    font-family: var(--font-mono); font-size: 13px; color: var(--gate);
    position: sticky; top: 76px; align-self: start; padding-top: 4px;
  }
  .rail::after { content: ''; display: block; width: 22px; height: 2px; background: var(--gate); margin-top: 8px; opacity: .5; }
  .cards { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  .paper-card {
    position: relative;
    background: var(--panel); border: 1px solid var(--skin-line); border-radius: 4px;
    padding: 16px 18px; display: flex; flex-direction: column; gap: 8px;
    transition: border-color .18s, transform .18s;
  }
  .paper-card:hover { border-color: var(--gate); transform: translateY(-2px); }
  .paper-card .venue { font-family: var(--font-mono); font-size: 11px; letter-spacing: .08em; color: var(--gate); }
  .paper-card h3 { font-family: var(--font-serif); font-size: 16px; line-height: 1.45; color: var(--fg); font-weight: 600; }
  .paper-card .authors { font-size: 12.5px; color: var(--skin-muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .paper-card .authors :global(b) { color: var(--gate); font-weight: 600; }
  .paper-card .row { display: flex; align-items: center; gap: 12px; font-size: 12px; color: var(--skin-muted); font-family: var(--font-mono); }
  .paper-card .row .lnk { color: var(--gate); }
  .paper-card .row .spark { margin-left: auto; letter-spacing: 2px; opacity: .6; color: var(--gate); }
  .first-author::before {
    content: '一作'; position: absolute; top: -9px; left: -8px; font-size: 10px;
    font-family: var(--font-ui); background: var(--gate); color: #fff;
    padding: 1px 7px; border-radius: 2px; letter-spacing: .1em;
  }
  @media (max-width: 960px) {
    .yearrow { grid-template-columns: minmax(0, 1fr); }
    .rail { position: static; padding: 18px 0 0; }
    .cards { grid-template-columns: 1fr; }
  }
</style>
