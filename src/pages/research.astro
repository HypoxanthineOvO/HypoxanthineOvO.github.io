---
import BaseLayout from '../layouts/BaseLayout.astro';
import GateHead from '../components/GateHead.astro';
import { getPublications } from '../lib/content';
import { researchIntro, simulators } from '../data/home';

const pubs = await getPublications();
const isFirst = (authors?: string[]) => authors?.[0] === 'Yunxiang He';
const mine = pubs.filter((p) => isFirst(p.data.authors));
const others = pubs.filter((p) => !isFirst(p.data.authors));
const shortVenue = (v?: string) => v?.match(/\(([^)]+)\)/)?.[1] ?? v ?? '';
---

<BaseLayout skin="research" title="研究" description="神经渲染加速器，以及低温 GPU 架构。">
  <section class="skin">
    <div class="shell">
      <GateHead
        gate="research"
        title="研究"
        note={`${pubs.length} PAPERS`}
        blurb="神经渲染加速器，以及还在路上的低温 GPU 架构。"
      />

      <div class="say">
        <p>{researchIntro.neural}</p>
        <p>{researchIntro.cryo}</p>
      </div>

      <div class="cards">
        {mine.map((p) => (
          <a class="paper-card" href={`/research/${p.id}`}>
            <span class="venue">一作 · {shortVenue(p.data.venue)} {p.data.year}</span>
            <h3>{p.data.title}</h3>
            <span class="authors">{(p.data.authors ?? []).join('，')}</span>
            <span class="row">
              {p.data.pdf && <span class="lnk">PDF</span>}
              {p.data.code && <span class="lnk">CODE</span>}
              <span class="spark">详情 →</span>
            </span>
          </a>
        ))}
        {simulators.map((s) => (
          <div class="paper-card sim">
            <span class="venue">{s.tag}</span>
            <h3>{s.name}</h3>
            <p>{s.desc}</p>
          </div>
        ))}
      </div>

      <div class="wall-head">
        <h2>其他参与</h2>
        <span>{others.length} 篇</span>
      </div>
      <ul class="others">
        {others.map((p) => (
          <li>
            <a href={`/research/${p.id}`}>
              <span class="y">{p.data.year}</span>
              <span class="t">{p.data.title}</span>
              <em>{shortVenue(p.data.venue)}</em>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .say { margin-top: 22px; max-width: 46em; }
  .say p { font-family: var(--font-serif); font-size: 17px; line-height: 1.95; color: var(--ink-2); }
  .say p + p { margin-top: 20px; font-size: 20px; line-height: 1.85; color: var(--fg); }

  .cards { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; margin-top: 34px; }
  .paper-card {
    position: relative;
    background: var(--panel); border: 1px solid var(--skin-line); border-radius: 10px;
    padding: 18px 20px; display: flex; flex-direction: column; gap: 9px;
    transition: border-color .18s, transform .18s;
  }
  .paper-card:hover { border-color: var(--gate); transform: translateY(-2px); }
  .paper-card .venue { font-family: var(--font-mono); font-size: 11.5px; letter-spacing: .06em; color: var(--gate); }
  .paper-card h3 { font-family: var(--font-serif); font-size: 16px; line-height: 1.5; color: var(--fg); font-weight: 600; }
  .paper-card .authors { font-size: 12.5px; color: var(--skin-muted); line-height: 1.6; }
  .paper-card p { font-size: 13px; line-height: 1.75; color: var(--ink-2); }
  .paper-card .row { margin-top: auto; display: flex; align-items: center; gap: 12px; font-size: 12px; color: var(--skin-muted); font-family: var(--font-mono); }
  .paper-card .row .lnk { color: var(--gate); }
  .paper-card .row .spark { margin-left: auto; opacity: .7; color: var(--gate); }
  .paper-card.sim { background: var(--paper-2); }

  .wall-head { display: flex; align-items: baseline; gap: 14px; margin-top: 52px; padding-bottom: 10px; border-bottom: 1.5px solid var(--fg); }
  .wall-head h2 { font-family: var(--font-serif); font-weight: 900; font-size: 22px; }
  .wall-head span { font-size: 13px; color: var(--skin-muted); }
  .others { list-style: none; margin: 6px 0 64px; }
  .others li + li { border-top: 1px dashed var(--skin-line); }
  .others a { display: flex; align-items: baseline; gap: 14px; padding: 12px 2px; font-size: 14.5px; line-height: 1.6; transition: color .2s, padding .2s; }
  .others a:hover { color: var(--gate); padding-left: 8px; }
  .others .y { flex: none; font-family: var(--font-mono); font-size: 12px; color: var(--skin-muted); }
  .others .t { flex: 1; min-width: 0; }
  .others em { flex: none; max-width: 32%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-style: normal; font-family: var(--font-mono); font-size: 11.5px; color: var(--skin-muted); }

  @media (max-width: 820px) {
    .cards { grid-template-columns: 1fr; }
    .others a { flex-wrap: wrap; gap: 4px 12px; }
    .others em { width: 100%; }
  }
</style>
