---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GateHead from '../../components/GateHead.astro';
import { getPublishArticles, getAiDailyIssues } from '../../lib/content';

const articles = await getPublishArticles();
const issues = getAiDailyIssues();
const latest = issues[0];
const ticker = issues.slice(0, 14);
const platformLabel = { wechat: '公众号', zhihu: '知乎', bilibili: 'B站', xiaohongshu: '小红书' } as const;
---

<BaseLayout skin="publish" title="发布">
  <section class="skin">
    <div class="shell">
      <GateHead
        gate="publish"
        blurb="写完的东西发往何处：公众号长文按篇陈列，AI 日报每天一期。知乎、B站、小红书的位子留好了，来了就上墙。"
      />

      <div class="paper">
        {latest && (
          <div>
            <div class="col-head"><h2>AI 日报</h2><span>{issues.length} 期 · 每天一期</span></div>
            <a class="daily-hero" href={`/publish/daily/${latest.date}`}>
              <span class="no">第 {issues.length} 期 · {latest.date}</span>
              <h3>{latest.title}</h3>
              {latest.summary && <p>{latest.summary}</p>}
              <div class="tags">
                {[...new Set(latest.items.map((i) => i.category))].slice(0, 3).map((c) => <span>{c}</span>)}
                <span>{latest.items.length} 条</span>
              </div>
            </a>
            <div class="ticker">
              {ticker.map((issue, i) => (
                <a href={`/publish/daily/${issue.date}`} title={issue.title}>{issues.length - i}</a>
              ))}
            </div>
            <p class="ticker-note">← 按期数直达 · <a href="/publish/daily">完整日报档案</a></p>
          </div>
        )}

        <div>
          <div class="col-head"><h2>长文</h2><span>公众号 · {articles.length} 篇</span></div>
          <div class="arts">
            {articles.map((a) => (
              <a class="art" href={`/publish/${a.id}`}>
                <h3>{a.data.title}</h3>
                <span class="plat">{platformLabel[a.data.platform]}</span>
                <div class="sub">
                  {a.data.column && <span class="cat">{a.data.column}</span>}
                  <span>{a.data.date.toISOString().slice(0, 7)}</span>
                </div>
              </a>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .paper { padding: 26px 0 64px; display: grid; grid-template-columns: 5fr 4fr; gap: 34px; align-items: start; }
  .col-head { display: flex; align-items: baseline; justify-content: space-between; border-bottom: 2px solid var(--fg); padding-bottom: 8px; margin-bottom: 4px; }
  .col-head h2 { font-family: var(--font-serif); font-size: 19px; }
  .col-head span { font-family: var(--font-mono); font-size: 11px; color: var(--gate); letter-spacing: .14em; }

  .daily-hero { display: block; padding: 18px 2px 16px; border-bottom: 1px solid var(--skin-line); }
  .daily-hero .no { font-family: var(--font-mono); font-size: 11px; color: var(--gate); letter-spacing: .16em; }
  .daily-hero h3 { font-family: var(--font-serif); font-size: 21px; line-height: 1.5; margin-top: 8px; }
  .daily-hero p {
    font-size: 13.5px; color: var(--skin-muted); margin-top: 8px; line-height: 1.8;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
  }
  .daily-hero .tags { margin-top: 10px; display: flex; gap: 8px; flex-wrap: wrap; }
  .daily-hero .tags span { font-size: 11px; font-family: var(--font-mono); border: 1px solid var(--skin-line); border-radius: 999px; padding: 1px 10px; color: var(--skin-muted); }
  .ticker { margin-top: 14px; display: flex; gap: 4px; align-items: center; overflow: hidden; }
  .ticker a {
    flex: 1; min-width: 7px; height: 26px; border-radius: 2px;
    background: color-mix(in srgb, var(--gate) 16%, transparent);
    display: flex; align-items: center; justify-content: center;
    font-family: var(--font-mono); font-size: 9px; color: var(--gate);
  }
  .ticker a:hover { background: var(--gate); color: #fff; }
  .ticker-note { margin-top: 8px; font-size: 11.5px; color: var(--skin-muted); font-family: var(--font-mono); }
  .ticker-note a { color: var(--gate); }

  .arts { display: flex; flex-direction: column; }
  .art { display: grid; grid-template-columns: 1fr auto; gap: 4px 14px; padding: 13px 2px; border-bottom: 1px dashed var(--skin-line); }
  .art:hover h3 { color: var(--gate); }
  .art h3 { font-family: var(--font-serif); font-size: 15.5px; line-height: 1.5; }
  .art .plat {
    font-family: var(--font-mono); font-size: 10px; border: 1px solid var(--gate); color: var(--gate);
    border-radius: 2px; padding: 0 6px; height: fit-content; align-self: center; letter-spacing: .08em;
  }
  .art .sub { grid-column: 1 / -1; display: flex; gap: 12px; font-size: 12px; color: var(--skin-muted); font-family: var(--font-mono); }
  .art .sub .cat { color: var(--gate); }
  @media (max-width: 960px) { .paper { grid-template-columns: 1fr; } }
</style>
