---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getAiDailyIssues } from '../../../lib/content';

export function getStaticPaths() {
  return getAiDailyIssues().map((issue) => ({ params: { date: issue.date }, props: { issue } }));
}

const { issue } = Astro.props;
const all = getAiDailyIssues();
const index = all.findIndex((i) => i.date === issue.date);
const newer = index > 0 ? all[index - 1] : null;
const older = index >= 0 && index < all.length - 1 ? all[index + 1] : null;
---

<BaseLayout skin="publish" title={issue.title} description={issue.summary}>
  <section class="skin">
    <div class="shell">
      <header class="issue-head">
        <a class="back" href="/publish/daily">← 日报档案</a>
        <p class="no">AI DAILY · 第 {all.length - index} 期 · {issue.date}</p>
        <h1>{issue.title}</h1>
        {issue.summary && <p class="sum">{issue.summary}</p>}
        <div class="meta"><span>{issue.items.length} 条新闻卡片</span><span>{issue.published ? '公众号已发布' : '写作档案'}</span></div>
      </header>
      <div class="news">
        {issue.items.map((item) => (
          <article class="news-card">
            <div class="top"><span>#{String(item.number).padStart(2, '0')}</span><span>{item.category}</span></div>
            <h2>{item.title}</h2>
            <p class="b">{item.body}</p>
            <footer>
              <span>来源见原稿</span>
              {item.url && <a href={item.url} target="_blank" rel="noreferrer">原文 ↗</a>}
            </footer>
          </article>
        ))}
      </div>
      <nav class="adj">
        {older && <a href={`/publish/daily/${older.date}`}>← {older.date}</a>}
        {newer && <a href={`/publish/daily/${newer.date}`}>{newer.date} →</a>}
      </nav>
    </div>
  </section>
</BaseLayout>

<style>
  .issue-head { padding: 52px 0 20px; border-bottom: 2px solid var(--fg); }
  .back { font-family: var(--font-mono); font-size: 12px; color: var(--gate); }
  .no { font-family: var(--font-mono); font-size: 11px; color: var(--gate); letter-spacing: .18em; margin-top: 14px; }
  h1 { font-family: var(--font-serif); font-size: 26px; line-height: 1.55; margin-top: 10px; }
  .sum { color: var(--skin-muted); margin-top: 12px; max-width: 46em; font-size: 14.5px; line-height: 1.9; }
  .meta { margin-top: 14px; display: flex; gap: 18px; font-family: var(--font-mono); font-size: 11px; color: var(--skin-muted); letter-spacing: .1em; }

  .news { padding: 26px 0 30px; display: grid; grid-template-columns: repeat(2, 1fr); gap: 14px; }
  .news-card { background: var(--panel); border: 1px solid var(--skin-line); border-radius: 5px; padding: 16px 18px; display: flex; flex-direction: column; gap: 8px; }
  .news-card .top { display: flex; justify-content: space-between; font-family: var(--font-mono); font-size: 10.5px; color: var(--gate); letter-spacing: .12em; }
  .news-card h2 { font-family: var(--font-serif); font-size: 16px; line-height: 1.55; }
  .news-card .b { font-size: 13px; color: var(--skin-muted); line-height: 1.85; }
  .news-card footer { margin-top: auto; padding-top: 8px; border-top: 1px dashed var(--skin-line); display: flex; justify-content: space-between; font-size: 11.5px; color: var(--skin-muted); font-family: var(--font-mono); }
  .news-card footer a { color: var(--gate); }

  .adj { padding: 0 0 64px; display: flex; justify-content: space-between; font-family: var(--font-mono); font-size: 12.5px; }
  .adj a { color: var(--gate); }
  @media (max-width: 960px) { .news { grid-template-columns: 1fr; } }
</style>
