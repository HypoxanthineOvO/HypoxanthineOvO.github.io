---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import GateHead from '../../../components/GateHead.astro';
import { getAiDailyIssues, groupBy } from '../../../lib/content';

const issues = getAiDailyIssues();
const byMonth = groupBy(issues, (i) => i.date.slice(0, 7));
---

<BaseLayout skin="publish" title="AI 日报 · 档案">
  <section class="skin">
    <div class="shell">
      <GateHead gate="publish" title="AI 日报" blurb="每天一期，收录当日的 AI 资讯与工程进展。按月归档。" note={`${issues.length} 期`} />
      <div class="months">
        {byMonth.map(({ key: month, items }) => (
          <div class="month">
            <h3>{month}</h3>
            <div class="rows">
              {items.map((issue) => (
                <a class="row" href={`/publish/daily/${issue.date}`}>
                  <span class="d">{issue.date.slice(5)}</span>
                  <span class="t">{issue.title}</span>
                  <span class="n">{issue.items.length} 条</span>
                </a>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .months { padding: 26px 0 64px; display: flex; flex-direction: column; gap: 26px; }
  .month h3 { font-family: var(--font-mono); font-size: 13px; color: var(--gate); letter-spacing: .18em; }
  .rows { margin-top: 10px; }
  .row {
    display: grid; grid-template-columns: 52px 1fr auto; gap: 16px; align-items: baseline;
    padding: 9px 4px; border-bottom: 1px dashed var(--skin-line); font-size: 13.5px;
  }
  .row:hover .t { color: var(--gate); }
  .row .d { font-family: var(--font-mono); font-size: 12px; color: var(--skin-muted); }
  .row .t { font-family: var(--font-serif); line-height: 1.55; }
  .row .n { font-family: var(--font-mono); font-size: 11px; color: var(--skin-muted); }
  @media (max-width: 960px) { .row { grid-template-columns: 44px 1fr auto; gap: 10px; } }
</style>
