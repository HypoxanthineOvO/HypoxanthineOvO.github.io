---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/home.css';
import ProjectDemo from '../components/demos/ProjectDemo.astro';
import { siteConfig, platforms } from '../lib/site';
import { getMedia, getProjects, getPublications, getEssays, getPoetry, getStudy, formatMonthDay } from '../lib/content';
import { avatarTags, recent, mcWorks, mcShots, researchNow, facets } from '../data/home';

const media = await getMedia();
const videos = media.filter((m) => m.data.kind === 'video');
const articles = media.filter((m) => m.data.kind === 'article' && m.data.status === 'published');
const leadVideo = videos.find((v) => v.data.status === 'published');
const moreVideos = videos.filter((v) => v !== leadVideo).slice(0, 2);

const projects = (await getProjects()).filter((p) => p.data.group === 'productivity' && p.data.featured);
const byOrder = [...projects].sort((a, b) => a.data.order - b.data.order);
const wides = byOrder.filter((p) => ['vspi', 'hypodoc', 'hypo-workflow'].includes(p.id));
const smalls = byOrder.filter((p) => !wides.includes(p) && p.data.tier !== 'rework');
const reworks = byOrder.filter((p) => p.data.tier === 'rework');
const projectHref = (p: (typeof byOrder)[number]) =>
  p.data.tier === 'stable' ? `/work/${p.id}` : (p.data.githubUrl ?? '/work');
const statusOf = (p: (typeof byOrder)[number]) =>
  p.data.tier === 'stable' ? { cls: '', text: p.data.version ?? '稳定' } : { cls: 'wip', text: p.data.tier === 'rework' ? '准备重做' : '开发中' };

const pubs = await getPublications();
const isMe = (a: string) => a === 'Yunxiang He';
const firstCount = pubs.filter((p) => isMe(p.data.authors?.[0] ?? '')).length;
const reps = pubs.filter((p) => p.data.featured).slice(0, 3);

const [essays, poetry, study] = await Promise.all([getEssays(), getPoetry(), getStudy()]);
const essayIds = ['行见录-遗憾篇', '灯河'];
const essayCards = essayIds.map((id) => essays.find((e) => e.id === id)).filter((e) => e !== undefined);
const firstSentence = (s?: string) => (s ?? '').replace(/^[“"「]?/, '').split(/[。！？]/)[0] + '。';
const studyFeature = study.find((s) => s.id === '宋词中的感性和理性');
const studyTerms = [...new Set(study.map((s) => s.data.term))];
const poem = {
  collection: poetry.find((p) => p.id === '2024年诗词创作'),
  title: '鹧鸪天·雪后小记',
  lines: ['白雪攀上小红墙，且行且看且思量。', '万籁俱寂浮云上，已似逍遥游四方。', '身欢畅，意徜徉，风与月共诉衷肠。', '君若似此三更雪，何惧输谁一段香？'],
};
const essayMeta: Record<string, { tag: string; meta: string }> = {
  '行见录-遗憾篇': { tag: '行见录', meta: `散文 ${essays.length} 篇` },
  灯河: { tag: '江城忆', meta: '高中作品' },
};
const cleanTitle = (t: string) => t.replace(/^【[^】]*】\s*/, '').replace(/^江城忆（[一二]）\s*/, '');

---

<BaseLayout>
  <!-- ============ HERO ============ -->
  <section class="hero">
    <div class="shell">
      <div class="rv">
        <div class="tagline"><span class="stamp">飘零聊科技</span> {siteConfig.tagline}</div>
        <h1>{siteConfig.brand}<span class="dot">.</span></h1>
        <div class="names"><b>{siteConfig.name}</b> {siteConfig.brandEn} · {siteConfig.affil}</div>
        <p class="pitch">把 AI 圈的事讲清楚，<br />顺便讲讲<em>为什么</em>。</p>
        <p class="bio">博士生，研究 <b>77 K 低温 GPU</b>。开发了 <b>VSPi</b> 等一系列 agent 工具。</p>
        <div class="platforms">
          {platforms.map((p) => {
            const Tag = p.href ? 'a' : 'span';
            return (
              <Tag class:list={['pf', { main: p.primary }]} href={p.href} rel={p.href ? 'noreferrer' : undefined} title={p.href ? undefined : `搜索「${p.handle}」`}>
                {p.label}{p.handle && <i>{p.handle}</i>}
              </Tag>
            );
          })}
        </div>
      </div>

      <div class="stage rv" id="stage">
        <div class="disc" id="disc">
          <div class="halo"></div>
          <div class="ring"></div>
          <img class="av" src={siteConfig.avatar} alt="Q 版的我和七个 AI" width="900" height="900" />
          {avatarTags.map((t) => (
            <span class="tag-ai" style={`left:${t.x}%;top:${t.y}%;--c:${t.color}`}>{t.name}<small>{t.org}</small></span>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ============ RECENT ============ -->
  <div class="now">
    <div class="row">
      <div class="label"><i></i>最近</div>
      <div class="marquee" id="marquee">
        {[0, 1].map((copy) => recent.map((r) => (
          <a href={r.href} aria-hidden={copy === 1 ? 'true' : undefined} tabindex={copy === 1 ? -1 : undefined}><b>{r.date}</b>{r.text}</a>
        )))}
      </div>
    </div>
  </div>

  <!-- ============ CONTENT ============ -->
  <section class="block" id="content">
    <div class="shell">
      <div class="sec-head rv">
        <span class="no">01</span><h2>内容</h2>
        <a class="more" href="/content">全部内容 →</a>
      </div>

      <div class="sub-head rv"><h3>视频</h3><span>抖音 · B站 · 视频号</span></div>
      <div class="content-grid">
        {leadVideo && (
          <a class="tilt c-feature rv" href={`/content/${leadVideo.id}`} data-video={leadVideo.data.video} data-poster={leadVideo.data.cover} data-title={leadVideo.data.title}>
            <div class="img vid" style={`background-image:url(${leadVideo.data.cover})`}><span class="playbig">▶</span>{leadVideo.data.duration && <span class="dur">{leadVideo.data.duration}</span>}</div>
            <div class="txt">
              <div class="kick"><span class="tag">{leadVideo.data.series}</span>{formatMonthDay(leadVideo.data.date)}</div>
              <h3>{leadVideo.data.title}</h3>
              <p>{leadVideo.data.description}</p>
            </div>
          </a>
        )}
        {moreVideos.map((v, i) => (
          <a class:list={['tilt c-card rv', i === 0 ? 'dark' : 'red']} href={`/content/${v.id}`} data-video={v.data.video} data-poster={v.data.cover} data-title={v.data.title}>
            <div class="kick"><span class="tag" style={i === 0 ? 'color:#f2b8b0' : undefined}>{v.data.series}</span>{v.data.status === 'upcoming' ? '制作中' : formatMonthDay(v.data.date)}</div>
            <h3>{v.data.title}</h3>
            <div class="meta"><span>{v.data.description}</span>{v.data.video ? <span class="play">▶</span> : <span class="soon">制作中</span>}</div>
          </a>
        ))}
      </div>

      <div class="sub-head rv"><h3>文章</h3><span>公众号 · 小红书</span></div>
      <div class="articles">
        {articles.map((a) => (
          <a class="tilt art rv" href={`/content/${a.id}`}>
            <div class="img" style={`background-image:url(${a.data.cover})`}></div>
            <div class="txt">
              <div class="kick"><span class="tag">{a.data.series}</span>{formatMonthDay(a.data.date)}</div>
              <h3>{a.data.title}</h3>
              <p>{a.data.description}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ PROJECTS ============ -->
  <section class="block" id="projects">
    <div class="shell">
      <div class="sec-head rv">
        <span class="no">02</span><h2>项目</h2>
        <a class="more" href="/work">全部项目 →</a>
      </div>

      <div class="sub-head rv"><h3>生产力</h3></div>
      <div class="showcase">
        {wides.map((p, i) => (
          <a class:list={['tilt show-row rv', { flip: i % 2 === 1, dark: p.id === 'vspi', violet: p.id === 'hypo-workflow' }]} href={projectHref(p)}>
            <div class="show-txt">
              <div class="top"><img class="ic" src={p.data.icon} alt="" width="56" height="56" /><span class="st"><i></i>{p.data.version}</span></div>
              <h3>{p.data.name}</h3>
              <p>{p.data.description}</p>
              <div class="hl">{p.data.highlights.map((h) => <span><b>{h.value}</b>{h.label}</span>)}</div>
              <span class="go">了解更多 →</span>
            </div>
            <div class="show-demo"><ProjectDemo id={p.id} /></div>
          </a>
        ))}
      </div>
      <div class="trio">
        {smalls.map((p) => {
          const st = statusOf(p);
          return (
            <a class="tilt trio-card rv" href={projectHref(p)} rel={projectHref(p).startsWith('http') ? 'noreferrer' : undefined}>
              <div class="trio-demo"><ProjectDemo id={p.id} /></div>
              <div class="trio-txt">
                <div class="top"><img class="ic sm" src={p.data.icon} alt="" width="40" height="40" /><h3>{p.data.name}</h3><span class="st"><i class={st.cls}></i>{st.text}</span></div>
                <p>{p.data.description}</p>
              </div>
            </a>
          );
        })}
      </div>
      {reworks.map((p) => (
        <a class="tilt p full rv" href={projectHref(p)} rel="noreferrer">
          <div class="top"><img class="ic" src={p.data.icon} alt="" width="52" height="52" /></div>
          <div class="mid"><h3>{p.data.name} <small class="wipnote">准备重做</small></h3><p>{p.data.description}</p></div>
          <div class="foot">{p.data.tech.map((t) => <span>{t}</span>)}</div>
        </a>
      ))}

      <div class="sub-head rv" id="minecraft"><h3>Minecraft</h3><span>开发中，内容会持续变化</span></div>
      <div class="mc-show rv" id="mcshow" data-works={JSON.stringify(mcWorks)} data-shots={JSON.stringify(mcShots)}>
        <div class="mc-view">
          <div class="mc-imgs" id="mcimgs">
            {mcShots.map((s, i) => <img src={s.img} alt={s.name} loading="lazy" class:list={{ on: i === 0 }} />)}
          </div>
          <div class="mc-cap">
            <div class="mc-title">
              <img class="mc-ic" id="mcic" src={mcWorks[mcShots[0].work].icon} alt="" width="44" height="44" />
              <span class="mc-badge" id="mcbadge">{mcWorks[mcShots[0].work].badge}</span>
              <h3 id="mcwork">{mcWorks[mcShots[0].work].title}</h3>
              <span class="st"><i class="wip"></i>开发中</span>
            </div>
            <div class="mc-now"><b id="mcname">{mcShots[0].name}</b><span id="mcdesc">{mcShots[0].desc}</span></div>
          </div>
        </div>
        <div class="mc-side">
          {(Object.keys(mcWorks) as (keyof typeof mcWorks)[]).map((w) => (
            <div class="mc-group">
              <div class="mc-gl">{mcWorks[w].badge} · {mcWorks[w].title}</div>
              <div class="mc-tabs">
                {mcShots.map((s, i) => s.work === w && (
                  <button class:list={['mc-tab', { on: i === 0 }]} data-i={i} type="button"><i style={`--ic:${s.color}`}></i>{s.name}<span class="bar"></span></button>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ============ RESEARCH ============ -->
  <section class="block" id="research">
    <div class="shell">
      <div class="sec-head rv">
        <span class="no">03</span><h2>研究</h2>
        <a class="more" href="/research">全部论文 →</a>
      </div>
      <div class="research">
        <div class="tilt cryo rv">
          <canvas id="frost"></canvas>
          <div class="kick">现在</div>
          <div class="temp">77<small>K</small></div>
          <h3>{researchNow.cryo.title}</h3>
          <p>{researchNow.cryo.desc}</p>
          <div class="gpu">
            <div class="gl">GPU 架构</div>
            <h3>{researchNow.gpu.title}</h3>
            <p>{researchNow.gpu.desc}</p>
          </div>
        </div>
        <div class="tilt papers rv">
          <div class="kick">此前 · 神经渲染加速器</div>
          <div class="stats">
            <div><b>{pubs.length}</b><span>篇论文</span></div>
            <div><b>{firstCount}</b><span>篇一作</span></div>
            <div><b>{new Set(pubs.map((p) => p.data.venue)).size}</b><span>个期刊与会议</span></div>
          </div>
          <div class="plist">
            {reps.map((p) => (
              <a href={`/research/${p.id}`}>
                <span class="y">{p.data.year}</span>
                <div><h4>{p.data.title}</h4><small>{isMe(p.data.authors?.[0] ?? '') && <><span class="first">一作</span> · </>}{p.data.venue?.match(/\(([^)]+)\)/)?.[1] ?? p.data.venue}</small></div>
              </a>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ WRITING ============ -->
  <section class="block" id="writing">
    <div class="shell">
      <div class="sec-head rv">
        <span class="no">04</span><h2>写作</h2>
        <a class="more" href="/writing">全部作品 →</a>
      </div>
      <div class="writing">
        <a class="tilt w-poem rv" href={poem.collection ? `/poetry/${poem.collection.id}` : '/poetry'} id="poem">
          <div class="kick">诗词 · 2024 年结集</div>
          <h3>{poem.title}</h3>
          <div class="lines">
            {poem.lines.map((l, i) => <span class:list={{ gap: i === 2 }}>{l}</span>)}
          </div>
          <div class="src">{poetry.length} 部诗词合集 →</div>
        </a>
        {essayCards.map((e) => (
          <a class="tilt w-item rv" href={`/essays/${e.id}`}>
            <div class="kick"><span class="tag">散文</span>{essayMeta[e.id]?.tag}</div>
            <h3>{cleanTitle(e.data.title)}</h3>
            <p>{firstSentence(e.data.description)}</p>
            <div class="meta">{essayMeta[e.id]?.meta}</div>
          </a>
        ))}
        {studyFeature && (
          <a class="tilt w-item rv" href="/study">
            <div class="kick"><span class="tag">学习档案</span>按学期</div>
            <h3>宋词里的感性和理性</h3>
            <p>人文课程论文、教评，及发表于《古典文学知识》的文章。</p>
            <div class="meta">{studyTerms.at(-1)} — {studyTerms[0]} · {study.length} 篇</div>
          </a>
        )}
      </div>
    </div>
  </section>

  <!-- ============ ABOUT ============ -->
  <section class="block" id="about">
    <div class="shell">
      <div class="sec-head rv"><span class="no">05</span><h2>关于</h2><a class="more" href="/about">更多 →</a></div>
      <div class="about">
        <div class="tilt life rv">
          <div class="kick">{siteConfig.name} · {siteConfig.brandEn} · {siteConfig.brand}</div>
          <p class="lead">{siteConfig.name}，{siteConfig.affil}博士生，导师{siteConfig.advisor}。<mark>大二起加入课题组</mark>。</p>
          <p>研究方向：<b>77 K 低温 GPU</b>、GPU 架构与模拟器。此前从事<b>神经渲染加速器</b>软硬件协同设计，发表论文 {pubs.length} 篇。</p>
          <p>AI 工具深度使用者，开发了 <b>VSPi</b> 等一系列工具，在“{siteConfig.brand} · {siteConfig.brandEn}”账号分享 AI 使用经验。</p>
          <div class="facets">
            {facets.map((f) => <span><b>{f.title}</b>{f.text}</span>)}
          </div>
        </div>
        <div class="tilt collab rv">
          <div class="img" style="background-image:url(/media/brand/banner.webp)"></div>
          <div class="in">
            <div class="kick"><span class="tag">合作</span></div>
            <h3>一起做点什么</h3>
            <p>AI 工具内容合作、科普视频、技术讲座。</p>
            <div class="btns"><a class="btn solid" href={`mailto:${siteConfig.email}`}>发邮件</a><span class="btn">公众号 Hypoxanthine</span></div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // 群像：名牌轮流高亮，鼠标带动轻微倾斜
  const stage = document.getElementById('stage')!;
  const disc = document.getElementById('disc')!;
  const tags = [...document.querySelectorAll<HTMLElement>('.tag-ai')];
  setTimeout(() => stage.classList.add('ready'), 500);
  let ti = 0;
  if (!reduce) setInterval(() => { tags.forEach((t, i) => t.classList.toggle('on', i === ti % tags.length)); ti++; }, 1600);
  stage.addEventListener('mousemove', (e) => {
    const r = stage.getBoundingClientRect();
    const dx = (e.clientX - r.left) / r.width - 0.5, dy = (e.clientY - r.top) / r.height - 0.5;
    disc.style.transform = `rotateY(${dx * 10}deg) rotateX(${-dy * 10}deg)`;
  });
  stage.addEventListener('mouseleave', () => { disc.style.transform = ''; });

  // 卡片倾斜与光泽
  document.querySelectorAll<HTMLElement>('.tilt').forEach((el) => {
    el.addEventListener('mousemove', (e) => {
      const r = el.getBoundingClientRect();
      const px = (e.clientX - r.left) / r.width, py = (e.clientY - r.top) / r.height;
      el.style.setProperty('--mx', `${px * 100}%`);
      el.style.setProperty('--my', `${py * 100}%`);
      el.style.transform = `perspective(900px) rotateY(${(px - 0.5) * 5}deg) rotateX(${(0.5 - py) * 5}deg) translateY(-4px)`;
    });
    el.addEventListener('mouseleave', () => { el.style.transform = ''; });
  });

  // 诗词逐句浮现
  const poemEl = document.getElementById('poem');
  if (poemEl) new IntersectionObserver((es, o) => { if (es[0].isIntersecting) { poemEl.classList.add('in'); o.disconnect(); } }, { threshold: 0.2 }).observe(poemEl);

  // Minecraft 展示：切换截图与作品名
  const show = document.getElementById('mcshow');
  if (show) {
    const works = JSON.parse(show.dataset.works ?? '{}');
    const shots: { work: string; name: string; desc: string }[] = JSON.parse(show.dataset.shots ?? '[]');
    const imgs = [...show.querySelectorAll<HTMLImageElement>('.mc-imgs img')];
    const tabs = [...show.querySelectorAll<HTMLButtonElement>('.mc-tab')].sort((a, b) => Number(a.dataset.i) - Number(b.dataset.i));
    const $ = (id: string) => document.getElementById(id)!;
    let cur = 0, timer = 0;
    const go = (i: number) => {
      cur = i;
      tabs.forEach((t, k) => t.classList.toggle('on', k === i));
      imgs.forEach((im, k) => im.classList.toggle('on', k === i));
      const w = works[shots[i].work];
      $('mcname').textContent = shots[i].name;
      $('mcdesc').textContent = shots[i].desc;
      $('mcbadge').textContent = w.badge;
      $('mcwork').textContent = w.title;
      ($('mcic') as HTMLImageElement).src = w.icon;
    };
    const auto = () => { clearInterval(timer); if (!reduce) timer = window.setInterval(() => go((cur + 1) % shots.length), 4500); };
    tabs.forEach((t, i) => {
      t.addEventListener('mouseenter', () => { go(i); clearInterval(timer); });
      t.addEventListener('click', () => { go(i); auto(); });
    });
    show.addEventListener('mouseleave', auto);
    auto();
  }

  // 77 K 卡片：冰晶粒子，躲开鼠标
  const cv = document.getElementById('frost') as HTMLCanvasElement | null;
  if (cv && !reduce) {
    const cx = cv.getContext('2d')!;
    let W = 0, H = 0, mx = -1, my = -1;
    let flakes: { x: number; y: number; r: number; v: number; a: number }[] = [];
    const size = () => {
      const r = cv.getBoundingClientRect(); const dpr = devicePixelRatio || 1;
      W = cv.width = r.width * dpr; H = cv.height = r.height * dpr;
      flakes = Array.from({ length: 70 }, () => ({ x: Math.random() * W, y: Math.random() * H, r: (Math.random() * 1.8 + 0.4) * dpr, v: Math.random() * 0.35 + 0.1, a: Math.random() * 0.6 + 0.2 }));
    };
    cv.parentElement!.addEventListener('mousemove', (e) => { const r = cv.getBoundingClientRect(); const d = devicePixelRatio || 1; mx = (e.clientX - r.left) * d; my = (e.clientY - r.top) * d; });
    cv.parentElement!.addEventListener('mouseleave', () => { mx = -1; });
    const frame = () => {
      cx.clearRect(0, 0, W, H);
      for (const f of flakes) {
        f.y -= f.v; f.x += Math.sin(f.y / 40) * 0.2;
        if (mx > 0) { const dx = f.x - mx, dy = f.y - my, d = Math.hypot(dx, dy); if (d < 90) { f.x += (dx / d) * 1.4; f.y += (dy / d) * 1.4; } }
        if (f.y < -5) { f.y = H + 5; f.x = Math.random() * W; }
        cx.beginPath(); cx.arc(f.x, f.y, f.r, 0, 7); cx.fillStyle = `rgba(190,220,255,${f.a})`; cx.fill();
      }
      requestAnimationFrame(frame);
    };
    size(); frame(); addEventListener('resize', size);
  }
</script>
