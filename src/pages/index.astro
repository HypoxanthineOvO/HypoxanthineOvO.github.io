---
import PillarArtwork from '../components/PillarArtwork.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroScene from '../components/HeroScene.astro';
import '../styles/home.css';
import ProjectDemo from '../components/demos/ProjectDemo.astro';
import ResearchTimeline from '../components/ResearchTimeline.astro';
import { siteConfig, platforms } from '../lib/site';
import { getMedia, getProjects, getPublications, getEssays, getPoetry, getStudy, formatMonthDay } from '../lib/content';
import { recent, contentPillars, mcWorks, mcShots, facets } from '../data/home';

// ---- 内容 ----
const media = await getMedia();
const publishedVideos = media.filter((m) => m.data.kind === 'video' && m.data.status === 'published');
const upcomingVideos = media.filter((m) => m.data.kind === 'video' && m.data.status === 'upcoming');
const leadVideo = publishedVideos.find((v) => v.id === 'video-vector-life-01') ?? publishedVideos[0];
const otherVideos = publishedVideos.filter((v) => v !== leadVideo);
const allVideos = media.filter((m) => m.data.kind === 'video');
const pillarSeries: Record<string, string> = { 'ai-basics': 'AI 科普', 'vector-life': '向量化人生', 'learn-with-ai': '用 AI 学习' };
const pillarCount = (key: string) => allVideos.filter((v) => v.data.series?.startsWith(pillarSeries[key])).length;

const articleIds = ['slow-research', 'ai-writing-tics', 'distill-fingerprint', 'vibe-coding-for-everyone', 'traditional-company-ai'];
const articles = articleIds
  .map((id) => media.find((m) => m.id === id && m.data.kind === 'article'))
  .filter((a): a is NonNullable<typeof a> => a !== undefined);
const [artLead, ...artRest] = articles;

// ---- 项目 ----
const projects = (await getProjects()).filter((p) => p.data.featured && p.data.layer);
const byOrder = [...projects].sort((a, b) => a.data.order - b.data.order);
type P = (typeof byOrder)[number];
const wideIds = ['vspi', 'hypo-workflow', 'hypo-info'];
const wideProjects = byOrder.filter((p) => wideIds.includes(p.id));
const smallProjects = byOrder.filter((p) => !wideIds.includes(p.id) && p.data.layer !== 'minecraft');
const projectHref = (p: P) => (p.data.tier === 'stable' ? `/work/${p.id}` : (p.data.githubUrl ?? '/work'));
const statusOf = (p: P) =>
  p.data.tier === 'stable' ? { cls: '', text: p.data.version ?? '稳定' } : { cls: 'wip', text: '开发中' };
const showCls = (p: P, i: number) => ({
  flip: i % 2 === 1,
  dark: p.id === 'vspi',
  violet: p.id === 'hypo-workflow',
  green: p.id === 'hypo-info',
});

// ---- 研究 ----
const pubs = await getPublications();

// ---- 写作 ----
const [essays, poetry, study] = await Promise.all([getEssays(), getPoetry(), getStudy()]);
const essayIds = ['行见录-遗憾篇', '灯河'];
const essayCards = essayIds.map((id) => essays.find((e) => e.id === id)).filter((e) => e !== undefined);
const firstSentence = (s?: string) => (s ?? '').replace(/^[“"「]?/, '').split(/[。！？]/)[0] + '。';
const studyFeature = study.find((s) => s.id === '宋词中的感性和理性');
const studyTerms = [...new Set(study.map((s) => s.data.term))];
const poem = {
  collection: poetry.find((p) => p.id === '2024年诗词创作'),
  title: '鹧鸪天·雪后小记',
  lines: ['白雪攀上小红墙，且行且看且思量。', '万籁俱寂浮云上，已似逍遥游四方。', '身欢畅，意徜徉，风与月共诉衷肠。', '君若似此三更雪，何惧输谁一段香？'],
};
const essayMeta: Record<string, { tag: string; meta: string }> = {
  '行见录-遗憾篇': { tag: '行见录', meta: `散文 ${essays.length} 篇` },
  灯河: { tag: '江城忆', meta: '高中作品' },
};
const cleanTitle = (t: string) => t.replace(/^【[^】]*】\s*/, '').replace(/^江城忆（[一二]）\s*/, '');
const first = mcShots[0];
---

<BaseLayout>
  <!-- ============ HERO ============ -->
  <section class="hero">
    <div class="shell">
      <div class="rv in">
        <div class="tagline"><span class="stamp">飘零聊科技</span> {siteConfig.tagline}</div>
        <h1>{siteConfig.brand}<span class="dot">.</span></h1>
        <div class="names"><b>{siteConfig.brandEn}</b> · {siteConfig.affil} 硕士研究生在读</div>
        <p class="pitch">前沿 AI 深度使用者、<br /><em>努力成为 AI 时代的超级个体</em></p>
        <p class="bio">硕士研究生在读，研究兴趣是 <b>神经渲染加速芯片</b> 与 <b>低温 GPU 架构</b>。AI 时代，没有人能独善其身，在深入使用和体验前沿 AI 工具后，我自研了 Agent 底座 <b>VSPi</b> 和 <b>Hypo-Workflow</b> 等 AI 工作流，也用它们制作了很多独属于我的工具。希望能将我对 AI 的理解分享给大家。</p>
        <div class="platforms">
          {platforms.map((p) => {
            const Tag = p.href ? 'a' : 'span';
            return (
              <Tag class:list={['pf', { main: p.primary }]} href={p.href} rel={p.href ? 'noreferrer' : undefined} title={p.href ? undefined : `搜索「${p.handle}」`}>
                {p.label}{p.handle && <i>{p.handle}</i>}
              </Tag>
            );
          })}
        </div>
      </div>

      <HeroScene />
    </div>
  </section>

  <!-- ============ RECENT ============ -->
  <div class="now">
    <div class="row">
      <div class="label"><i></i>最近</div>
      <div class="marquee" id="marquee">
        {[0, 1].map((copy) => recent.map((r) => (
          <a href={r.href} aria-hidden={copy === 1 ? 'true' : undefined} tabindex={copy === 1 ? -1 : undefined}><b>{r.date}</b>{r.text}</a>
        )))}
      </div>
    </div>
  </div>

  <!-- ============ CONTENT ============ -->
  <section class="block" id="content">
    <div class="shell">
      <div class="sec-head rv">
        <span class="no">01</span><h2>内容</h2>
        <a class="more" href="/content">全部内容 →</a>
      </div>

      <div class="pillars">
        {contentPillars.map((p) => {
          const n = pillarCount(p.key);
          return (
            <a class="tilt pillar rv" href="/content" data-pillar={p.key}>
              <PillarArtwork src={p.image} />
              <div class="pk"><h3>{p.title}</h3><span class="cnt">{n > 0 ? `${n} 期视频` : '视频筹备中'}</span></div>
              <p>{p.desc}</p>
            </a>
          );
        })}
      </div>

      <div class="sub-head rv"><h3>视频</h3><span>抖音 · B站 · 视频号 · 点击封面站内播放</span></div>
      <div class="vid-wrap">
        {leadVideo && (
          <a class="tilt v-lead rv" href={`/content/${leadVideo.id}`} data-video={leadVideo.data.video} data-poster={leadVideo.data.cover} data-title={leadVideo.data.title}>
            <div class="vthumb"><img class="cover-image" src={leadVideo.data.cover} alt="" loading="lazy" decoding="async" sizes="(max-width: 980px) calc(100vw - 48px), 720px" />
              <span class="playbig">▶</span>
              {leadVideo.data.duration && <span class="dur">{leadVideo.data.duration}</span>}
              <span class="flag">主推 · 最新旗舰</span>
            </div>
            <div class="txt">
              <div class="kick"><span class="tag">{leadVideo.data.series}</span>{formatMonthDay(leadVideo.data.date)}</div>
              <h3>{leadVideo.data.title}</h3>
              <p>{leadVideo.data.description}</p>
            </div>
          </a>
        )}
        <div class="v-side">
          {otherVideos.map((v) => (
            <a class="tilt v-row rv" href={`/content/${v.id}`} data-video={v.data.video} data-poster={v.data.cover} data-title={v.data.title}>
              <div class="vthumb"><img class="cover-image" src={v.data.cover} alt="" loading="lazy" decoding="async" sizes="(max-width: 620px) calc(100vw - 68px), 400px" />
                <span class="play">▶</span>
                {v.data.duration && <span class="dur">{v.data.duration}</span>}
              </div>
              <div class="txt">
                <div class="kick"><span class="tag">{v.data.series}</span>{formatMonthDay(v.data.date)}</div>
                <h4>{v.data.title}</h4>
              </div>
            </a>
          ))}
        </div>
      </div>
      {upcomingVideos.map((v) => (
        <a class="tilt v-soon rv" href={`/content/${v.id}`}>
          <span class="soon-badge">制作中</span>
          <div class="soon-txt">
            <div class="kick"><span class="tag">{v.data.series}</span>即将发布</div>
            <h4>{v.data.title}</h4>
            <p>{v.data.description}</p>
          </div>
          <span class="soon-go">看企划 →</span>
        </a>
      ))}

      <div class="sub-head rv"><h3>文章</h3><span>公众号 · 小红书</span></div>
      {artLead && (
        <a class="tilt art-lead rv" href={`/content/${artLead.id}`}>
          <div class="img image-frame"><img class="cover-image" src={artLead.data.cover} alt="" loading="lazy" decoding="async" sizes="(max-width: 980px) calc(100vw - 48px), 660px" /></div>
          <div class="txt">
            <div class="kick"><span class="tag">{artLead.data.series}</span>{formatMonthDay(artLead.data.date)}</div>
            <h3>{artLead.data.title}</h3>
            <p>{artLead.data.description}</p>
          </div>
        </a>
      )}
      <div class="articles">
        {artRest.map((a) => (
          <a class="tilt art rv" href={`/content/${a.id}`}>
            <div class="img image-frame"><img class="cover-image" src={a.data.cover} alt="" loading="lazy" decoding="async" sizes="(max-width: 620px) calc(100vw - 48px), (max-width: 980px) 45vw, 300px" /></div>
            <div class="txt">
              <div class="kick"><span class="tag">{a.data.series}</span>{formatMonthDay(a.data.date)}</div>
              <h3>{a.data.title}</h3>
              <p>{a.data.description}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ PROJECTS ============ -->
  <section class="block" id="projects">
    <div class="shell">
      <div class="sec-head rv">
        <span class="no">02</span><h2>项目</h2>
        <p>自己写的 Agent 工具和日常产品，还有两个 Minecraft 作品</p>
        <a class="more" href="/work">全部项目 →</a>
      </div>

      <div class="showcase">
        {wideProjects.map((p, i) => (
          <a class:list={['tilt show-row rv', showCls(p, i)]} href={projectHref(p)}>
            <div class="show-txt">
              <div class="top"><img class="ic" src={p.data.icon} alt="" width="56" height="56" /><span class="st"><i></i>{p.data.version}</span></div>
              <h3>{p.data.name}</h3>
              <p>{p.data.description}</p>
              <div class="hl">{p.data.highlights.map((h) => <span><b>{h.value}</b>{h.label}</span>)}</div>
              <span class="go">了解更多 →</span>
            </div>
            <div class="show-demo"><ProjectDemo id={p.id} /></div>
          </a>
        ))}
      </div>
      {smallProjects.length > 0 && (
        <div class="trio">
          {smallProjects.map((p) => {
            const st = statusOf(p);
            const href = projectHref(p);
            return (
              <a class="tilt trio-card rv" href={href} rel={href.startsWith('http') ? 'noreferrer' : undefined}>
                <div class="trio-demo"><ProjectDemo id={p.id} /></div>
                <div class="trio-txt">
                  <div class="top"><img class="ic sm" src={p.data.icon} alt="" width="40" height="40" /><h3>{p.data.name}</h3><span class="st"><i class={st.cls}></i>{st.text}</span></div>
                  <p>{p.data.description}</p>
                  {p.data.highlights.length > 0 && <div class="hl sm">{p.data.highlights.map((h) => <span><b>{h.value}</b>{h.label}</span>)}</div>}
                </div>
              </a>
            );
          })}
        </div>
      )}
        <div class="mc-show rv" id="mcshow" data-works={JSON.stringify(mcWorks)} data-shots={JSON.stringify(mcShots)}>
          <div class="mc-view">
            <div class="mc-imgs" id="mcimgs">
              {mcShots.map((s, i) => <img src={i === 0 ? s.img : undefined} data-src={i === 0 ? undefined : s.img} alt={s.name} loading="lazy" decoding="async" sizes="(max-width: 980px) calc(100vw - 48px), 900px" class:list={{ on: i === 0 }} />)}
            </div>
            <div class="mc-cap">
              <div class="mc-title">
                <img data-no-optimize class="mc-ic" id="mcic" src={mcWorks[first.work].icon} alt="" width="44" height="44" />
                <span class="mc-badge" id="mcbadge">{mcWorks[first.work].badge}</span>
                <h3 id="mcwork">{mcWorks[first.work].title}</h3>
                <a class="mc-go" id="mcgo" href={mcWorks[first.work].href}>{mcWorks[first.work].cta}</a>
              </div>
              <div class="mc-now"><b id="mcname">{first.name}</b><span id="mcdesc">{first.desc}</span></div>
            </div>
          </div>
          <div class="mc-side">
            {(Object.keys(mcWorks) as (keyof typeof mcWorks)[]).map((w) => (
              <div class="mc-group">
                <div class="mc-gl">{mcWorks[w].badge} · {mcWorks[w].title}</div>
                <div class="mc-tabs">
                  {mcShots.map((s, i) => s.work === w && (
                    <button class:list={['mc-tab', { on: i === 0 }]} data-i={i} type="button"><i style={`--ic:${s.color}`}></i>{s.name}<span class="bar"></span></button>
                  ))}
                </div>
              </div>
            ))}
            <div class="mc-links">
              {(Object.keys(mcWorks) as (keyof typeof mcWorks)[]).map((w) => (
                <a class="mc-link" href={mcWorks[w].href}><img src={mcWorks[w].icon} alt="" width="28" height="28" /><span>{mcWorks[w].cta}</span></a>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ RESEARCH ============ -->
  <section class="block" id="research">
    <div class="shell">
      <div class="sec-head rv">
        <span class="no">03</span><h2>研究</h2>
        <a class="more" href="/research">研究详情 →</a>
      </div>
      <div class="rv">
        <ResearchTimeline />
      </div>
    </div>
  </section>

  <!-- ============ WRITING ============ -->
  <section class="block" id="writing">
    <div class="shell">
      <div class="sec-head rv">
        <span class="no">04</span><h2>写作</h2>
        <a class="more" href="/writing">全部作品 →</a>
      </div>
      <div class="writing">
        <a class="tilt w-poem rv" href={poem.collection ? `/poetry/${poem.collection.id}` : '/poetry'} id="poem">
          <div class="kick">诗词 · 2024 年结集</div>
          <h3>{poem.title}</h3>
          <div class="lines">
            {poem.lines.map((l, i) => <span class:list={{ gap: i === 2 }}>{l}</span>)}
          </div>
          <div class="src">{poetry.length} 部诗词合集 →</div>
        </a>
        {essayCards.map((e) => (
          <a class="tilt w-item rv" href={`/essays/${e.id}`}>
            <div class="kick"><span class="tag">散文</span>{essayMeta[e.id]?.tag}</div>
            <h3>{cleanTitle(e.data.title)}</h3>
            <p>{firstSentence(e.data.description)}</p>
            <div class="meta">{essayMeta[e.id]?.meta}</div>
          </a>
        ))}
        {studyFeature && (
          <a class="tilt w-item rv" href="/study">
            <div class="kick"><span class="tag">学习档案</span>按学期</div>
            <h3>宋词里的感性和理性</h3>
            <p>人文课程论文、教评，及发表于《古典文学知识》的文章。</p>
            <div class="meta">{studyTerms.at(-1)} — {studyTerms[0]} · {study.length} 篇</div>
          </a>
        )}
      </div>
    </div>
  </section>

  <!-- ============ ABOUT ============ -->
  <section class="block" id="about">
    <div class="shell">
      <div class="sec-head rv"><span class="no">05</span><h2>关于</h2><a class="more" href="/about">更多 →</a></div>
      <div class="about">
        <div class="tilt life rv">
          <div class="kick">{siteConfig.brand} · {siteConfig.brandEn}</div>
          <p class="lead">{siteConfig.brand} · {siteConfig.brandEn}，{siteConfig.affil} 硕士研究生在读。<mark>大二（2022 年 8 月）起加入课题组</mark>。</p>
          <p>科研有两条线：从大二持续至今的<b>神经渲染</b>（{pubs.length} 篇论文），以及 2025 年底分叉开启的 <b>77 K 低温 GPU 架构</b>。</p>
          <p>AI 方面深入研究 Agent 细节、评测各类模型，自研 <b>VSPi</b> 等底座与 Workflow、HypoDoc、Expression，并造出信息引擎和游戏产品，在“{siteConfig.brand} · {siteConfig.brandEn}”账号分享。</p>
          <div class="facets">
            {facets.map((f) => <span><b>{f.title}</b>{f.text}</span>)}
          </div>
        </div>
        <div class="tilt collab rv">
          <div class="img image-frame"><img class="cover-image" src="/media/brand/banner.webp" alt="" loading="lazy" decoding="async" sizes="(max-width: 980px) calc(100vw - 48px), 640px" /></div>
          <div class="in">
            <div class="kick"><span class="tag">合作</span></div>
            <h3>一起做点什么</h3>
            <p>AI 工具内容合作、科普视频、技术讲座。</p>
            <div class="btns"><a class="btn solid" href={`mailto:${siteConfig.email}`}>发邮件</a><span class="btn">公众号 Hypoxanthine</span></div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // 卡片倾斜与光泽
  document.querySelectorAll<HTMLElement>('.tilt').forEach((el) => {
    el.addEventListener('mousemove', (e) => {
      const r = el.getBoundingClientRect();
      const px = (e.clientX - r.left) / r.width, py = (e.clientY - r.top) / r.height;
      el.style.setProperty('--mx', `${px * 100}%`);
      el.style.setProperty('--my', `${py * 100}%`);
      el.style.transform = `perspective(900px) rotateY(${(px - 0.5) * 5}deg) rotateX(${(0.5 - py) * 5}deg) translateY(-4px)`;
    });
    el.addEventListener('mouseleave', () => { el.style.transform = ''; });
  });

  // 诗词逐句浮现
  const poemEl = document.getElementById('poem');
  if (poemEl) new IntersectionObserver((es, o) => { if (es[0].isIntersecting) { poemEl.classList.add('in'); o.disconnect(); } }, { threshold: 0.2 }).observe(poemEl);

  // Minecraft 展示：切换截图、作品名与详情入口
  const show = document.getElementById('mcshow');
  if (show) {
    const works = JSON.parse(show.dataset.works ?? '{}');
    const shots: { work: string; name: string; desc: string }[] = JSON.parse(show.dataset.shots ?? '[]');
    const imgs = [...show.querySelectorAll<HTMLImageElement>('.mc-imgs img')];
    const tabs = [...show.querySelectorAll<HTMLButtonElement>('.mc-tab')].sort((a, b) => Number(a.dataset.i) - Number(b.dataset.i));
    const $ = (id: string) => document.getElementById(id)!;
    let cur = 0, timer = 0, visible = false;
    const prepare = (i: number) => {
      const img = imgs[i];
      if (!img?.dataset.src) return;
      if (img.dataset.srcset) img.srcset = img.dataset.srcset;
      img.src = img.dataset.src;
      delete img.dataset.src;
    };
    const go = (i: number) => {
      prepare(i);
      prepare((i + 1) % shots.length);
      cur = i;
      tabs.forEach((t, k) => t.classList.toggle('on', k === i));
      imgs.forEach((im, k) => im.classList.toggle('on', k === i));
      const w = works[shots[i].work];
      $('mcname').textContent = shots[i].name;
      $('mcdesc').textContent = shots[i].desc;
      $('mcbadge').textContent = w.badge;
      $('mcwork').textContent = w.title;
      ($('mcic') as HTMLImageElement).src = w.icon;
      const link = $('mcgo') as HTMLAnchorElement;
      link.href = w.href;
      link.textContent = w.cta;
    };
    const auto = () => {
      clearInterval(timer);
      show.classList.toggle('paused', !visible || document.hidden || reduce);
      if (visible && !document.hidden && !reduce) timer = window.setInterval(() => go((cur + 1) % shots.length), 4500);
    };
    tabs.forEach((t, i) => {
      t.addEventListener('mouseenter', () => { go(i); clearInterval(timer); });
      t.addEventListener('click', () => { go(i); auto(); });
    });
    show.addEventListener('mouseleave', auto);
    document.addEventListener('visibilitychange', auto);
    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      if (visible) prepare((cur + 1) % shots.length);
      auto();
    }, { threshold: 0.05 }).observe(show);
    auto();
  }
</script>
