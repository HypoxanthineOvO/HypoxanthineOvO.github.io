---
import { Languages, Menu, Search, X } from '@lucide/astro';

import { navLinks } from '../lib/site';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  lang?: 'zh' | 'en';
}

const { lang = 'zh' } = Astro.props;
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const translatedPaths = new Set(['/', '/work', '/research', '/about']);
const englishPath = translatedPaths.has(pathname) ? (pathname === '/' ? '/en' : `/en${pathname}`) : '/en';
const chinesePath = pathname.startsWith('/en') ? pathname.replace(/^\/en/, '') || '/' : pathname;

const localizedHref = (href: string) => (lang === 'en' && ['/work', '/research', '/about'].includes(href) ? `/en${href}` : href);
---

<header class="site-header" data-site-header>
  <div class="site-header__inner">
    <a href={lang === 'en' ? '/en' : '/'} class="brand-lockup" aria-label={lang === 'en' ? 'Hypoxanthine home' : 'Hypoxanthine 首页'}>
      <span class="brand-lockup__mark">H</span>
      <span class="brand-lockup__text">HYPOXANTHINE</span>
    </a>

    <nav class="desktop-nav" aria-label={lang === 'en' ? 'Primary navigation' : '主导航'}>
      {
        navLinks.map((link) => {
          const href = localizedHref(link.href);
          const active = pathname === href || pathname.startsWith(`${href}/`);
          return (
            <a href={href} class:list={['desktop-nav__link', active && 'is-active']} aria-current={active ? 'page' : undefined}>
              {lang === 'en' ? link.labelEn : link.label}
            </a>
          );
        })
      }
    </nav>

    <div class="site-tools">
      <a class="icon-button" href="/search" aria-label={lang === 'en' ? 'Search' : '搜索'} title={lang === 'en' ? 'Search' : '搜索'}>
        <Search size={18} stroke-width={1.8} aria-hidden="true" />
      </a>
      <a class="icon-button" href={lang === 'en' ? chinesePath : englishPath} aria-label={lang === 'en' ? '切换到中文' : 'Switch to English'} title={lang === 'en' ? '切换到中文' : 'Switch to English'}>
        <Languages size={18} stroke-width={1.8} aria-hidden="true" />
      </a>
      <ThemeToggle />
      <details class="mobile-menu">
        <summary class="icon-button" aria-label={lang === 'en' ? 'Open menu' : '打开菜单'}>
          <Menu class="mobile-menu__open" size={19} stroke-width={1.8} aria-hidden="true" />
          <X class="mobile-menu__close" size={19} stroke-width={1.8} aria-hidden="true" />
        </summary>
        <nav class="mobile-menu__panel" aria-label={lang === 'en' ? 'Mobile navigation' : '移动导航'}>
          {
            navLinks.map((link) => (
              <a href={localizedHref(link.href)}>{lang === 'en' ? link.labelEn : link.label}</a>
            ))
          }
        </nav>
      </details>
    </div>
  </div>
</header>
