---
import { ArrowUpRight, Grid3x3, List, Search } from '@lucide/astro';
import { localize, projects, type Locale } from '../data/portfolio';
import BaseLayout from '../layouts/BaseLayout.astro';

interface Props { lang?: Locale }
const { lang = 'zh' } = Astro.props;
const copy = lang === 'en'
  ? { eyebrow: 'WORK / SYSTEMS', title: 'A field of systems, not a shelf of demos.', intro: 'Research infrastructure, agent tooling, document systems, and long-lived personal tools. Field shows the relationships; Index is the complete searchable view.', field: 'Field', index: 'Index', search: 'Search work', all: 'All', research: 'Research', systems: 'Systems', writing: 'Writing', tools: 'Tools' }
  : { eyebrow: '项目 / SYSTEMS', title: '这些系统不是一排 Demo，而是一张持续生长的关系网。', intro: '研究基础设施、Agent 工具、文档系统与长期个人工具。Field 展示关系，Index 提供完整、可搜索的无障碍列表。', field: '关系场', index: '索引', search: '搜索项目', all: '全部', research: '研究', systems: '系统', writing: '写作', tools: '工具' };
const positions = [
  ['7%', '9%'], ['36%', '7%'], ['69%', '12%'], ['18%', '37%'], ['51%', '38%'], ['75%', '50%'], ['9%', '69%'], ['42%', '70%'], ['70%', '76%'],
];
---

<BaseLayout lang={lang} title={lang === 'en' ? 'Work' : '项目'} description={copy.intro}>
  <header class="inner-hero"><div class="page-shell"><p class="instrument-label instrument-label--dark">{copy.eyebrow}</p><h1>{copy.title}</h1><p>{copy.intro}</p></div></header>
  <section class="inner-section"><div class="page-shell">
    <div class="section-intro">
      <div class="segmented" role="group" aria-label={lang === 'en' ? 'Work view' : '项目视图'}>
        <button type="button" aria-pressed="true" data-work-view="field"><Grid3x3 size={17} aria-hidden="true" /> {copy.field}</button>
        <button type="button" aria-pressed="false" data-work-view="index"><List size={17} aria-hidden="true" /> {copy.index}</button>
      </div>
      <label class="search-control"><Search size={17} aria-hidden="true" /><span class="sr-only">{copy.search}</span><input class="search-input" type="search" placeholder={copy.search} data-work-search /></label>
    </div>
    <div class="filter-bar" aria-label={lang === 'en' ? 'Project categories' : '项目分类'}>
      {['all','research','systems','writing','tools'].map((category, index) => <button type="button" aria-pressed={index === 0 ? 'true' : 'false'} data-work-filter={category}>{copy[category as keyof typeof copy]}</button>)}
    </div>
    <div class="field-view" data-view-panel="field">
      <div class="field-grid"></div>
      {projects.map((project, index) => (
        <a class="field-node" href={project.url ?? '#'} target={project.url?.startsWith('http') ? '_blank' : undefined} rel="noreferrer" data-work-item data-category={project.category} data-haystack={`${project.name} ${localize(project.description, lang)} ${project.tech.join(' ')}`} style={`left:${positions[index][0]};top:${positions[index][1]}`}>
          <span>{project.period} / {project.category}</span><h3>{project.name}</h3><p>{localize(project.label, lang)}</p>
        </a>
      ))}
    </div>
    <div class="index-list" data-view-panel="index" hidden>
      {projects.map((project) => (
        <a class="index-row" href={project.url ?? '#'} target={project.url?.startsWith('http') ? '_blank' : undefined} rel="noreferrer" data-work-item data-category={project.category} data-haystack={`${project.name} ${localize(project.description, lang)} ${project.tech.join(' ')}`}>
          <span>{project.period}</span><div><h2>{project.name}</h2><div class="index-row__tags">{project.tech.map((tech) => <span>{tech}</span>)}</div></div><div><p>{localize(project.description, lang)}</p></div><ArrowUpRight size={20} aria-hidden="true" />
        </a>
      ))}
    </div>
  </div></section>
</BaseLayout>

<script>
  const buttons = document.querySelectorAll<HTMLElement>('[data-work-view]');
  const panels = document.querySelectorAll<HTMLElement>('[data-view-panel]');
  const filters = document.querySelectorAll<HTMLElement>('[data-work-filter]');
  const input = document.querySelector<HTMLInputElement>('[data-work-search]');
  let category = 'all';
  const apply = () => {
    const query = input?.value.trim().toLocaleLowerCase() ?? '';
    document.querySelectorAll<HTMLElement>('[data-work-item]').forEach((item) => {
      const categoryMatch = category === 'all' || item.dataset.category === category;
      const queryMatch = !query || item.dataset.haystack?.toLocaleLowerCase().includes(query);
      item.hidden = !(categoryMatch && queryMatch);
    });
  };
  buttons.forEach((button) => button.addEventListener('click', () => {
    buttons.forEach((entry) => entry.setAttribute('aria-pressed', String(entry === button)));
    panels.forEach((panel) => { panel.hidden = panel.dataset.viewPanel !== button.dataset.workView; });
  }));
  filters.forEach((button) => button.addEventListener('click', () => {
    category = button.dataset.workFilter ?? 'all';
    filters.forEach((entry) => entry.setAttribute('aria-pressed', String(entry === button)));
    apply();
  }));
  input?.addEventListener('input', apply);
</script>
