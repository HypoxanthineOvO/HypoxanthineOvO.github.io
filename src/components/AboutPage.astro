---
import { ArrowUpRight, CodeXml, Mail } from '@lucide/astro';
import type { Locale } from '../data/portfolio';
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../lib/site';
interface Props { lang?: Locale }
const { lang = 'zh' } = Astro.props;
const copy = lang === 'en'
  ? { eyebrow: 'ABOUT / YUNXIANG HE', title: 'Researcher, systems builder, and an unapologetic archivist.', intro: 'I am Yunxiang He, also known as Hypoxanthine, a graduate researcher at ShanghaiTech VSP Lab. My current work focuses on cryogenic GPU systems at 77 K.', p1: 'I moved from neural-rendering hardware acceleration toward broader GPU architecture and cryogenic computing. The shift kept the same habit: turn vague systems questions into traceable evidence, reproducible models, and tools that other people can inspect.', p2: 'Alongside research, I build agent workflows, document systems, terminal interfaces, and Chinese writing pipelines. Outside systems work, I write poetry and essays, teach, and build data tools around table tennis and badminton.', p3: 'This site keeps those threads together without pretending they are one job title.', contact: 'Contact & identity', current: 'Current', previous: 'Earlier', beyond: 'Beyond' }
  : { eyebrow: '关于 / YUNXIANG HE', title: '研究者、系统构建者，也是一个不太愿意丢掉痕迹的人。', intro: '我是贺云翔，网名 Hypoxanthine，上海科技大学 VSP Lab 研究生。当前研究聚焦 77 K 低温 GPU 系统。', p1: '我从神经渲染硬件加速转向更广义的 GPU 架构与 cryogenic computing。方向变了，工作习惯没有变：把模糊的系统问题拆成可追溯证据、可复现模型，以及别人能够检查的工具。', p2: '研究之外，我持续搭建 Agent 工作流、文档系统、终端界面和中文写作管线。系统之外，我写诗和散文，也做教学材料，以及围绕乒乓球、羽毛球的数据工具。', p3: '这个站点把这些线索放在一起，但不假装它们只是一种职位。', contact: '联系与身份', current: '现在', previous: '此前', beyond: '系统之外' };
---
<BaseLayout lang={lang} title={lang === 'en' ? 'About' : '关于'} description={copy.intro} image="/media/profile/yunxiang-he.webp">
  <header class="inner-hero"><div class="page-shell"><p class="instrument-label instrument-label--dark">{copy.eyebrow}</p><h1>{copy.title}</h1><p>{copy.intro}</p></div></header>
  <section class="inner-section"><div class="page-shell about-layout"><aside><img src="/media/profile/yunxiang-he.webp" alt="Yunxiang He / 贺云翔" width="480" height="480" /><div class="about-contact"><h2>{copy.contact}</h2><a href={siteConfig.github} target="_blank" rel="noreferrer"><CodeXml size={17} /> GitHub <ArrowUpRight size={15} /></a><a href={`mailto:${siteConfig.email}`}><Mail size={17} /> {siteConfig.email}</a></div></aside><div class="about-copy"><p class="lead-copy">{copy.p1}</p><p class="lead-copy">{copy.p2}</p><p class="lead-copy">{copy.p3}</p><dl class="about-readout"><div><dt>{copy.current}</dt><dd>Cryogenic GPU Systems · VSP Lab · 77 K</dd></div><div><dt>{copy.previous}</dt><dd>Neural Rendering · Hardware Acceleration · GPU Architecture</dd></div><div><dt>{copy.beyond}</dt><dd>Writing · Teaching · Table Tennis · Badminton</dd></div></dl></div></div></section>
</BaseLayout>
