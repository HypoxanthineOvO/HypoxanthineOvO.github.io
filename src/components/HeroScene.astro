---
const poster = '/media/brand/hero-classroom.webp';
const description = '飘零听 Gemini 讲解，GLM 在旁记笔记；GPT 与 Claude 聊天，Kimi 弹吉他，DeepSeek 吃饭，MiniMax 画画，豆包在后排睡觉，Grok 从窗外探头。';
---

<div class="hero-scene" data-hero-scene>
  <img class="scene-poster" src={poster} alt={description} width="1448" height="1086" sizes="(max-width: 620px) calc(100vw - 36px), (max-width: 980px) min(640px, calc(100vw - 64px)), 535px" fetchpriority="high" decoding="async" />
</div>

<style>
  .hero-scene { position: relative; aspect-ratio: 4 / 3; overflow: hidden; border: 1px solid var(--line); border-radius: 18px; background: var(--panel); }
  .scene-poster { display: block; width: 100%; height: 100%; object-fit: contain; }
</style>
