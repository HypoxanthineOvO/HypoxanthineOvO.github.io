<div class="thermal-field" data-thermal-field aria-hidden="true">
  <canvas class="thermal-field__canvas"></canvas>
  <img class="thermal-field__fallback" src="/media/projects/ai-daily.webp" alt="" width="1536" height="864" />
  <div class="thermal-field__scan"></div>
</div>

<script>
  import * as THREE from 'three';

  const containers = document.querySelectorAll<HTMLElement>('[data-thermal-field]:not([data-ready])');

  containers.forEach((container) => {
    container.dataset.ready = 'true';
    const canvas = container.querySelector('canvas');
    const fallback = container.querySelector('img');
    if (!canvas) return;

    let renderer: THREE.WebGLRenderer;
    try {
      renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true, powerPreference: 'high-performance' });
    } catch {
      fallback?.classList.add('is-visible');
      return;
    }

    const scene = new THREE.Scene();
    scene.fog = new THREE.FogExp2(0x080a0c, 0.042);
    const camera = new THREE.PerspectiveCamera(42, 1, 0.1, 100);
    camera.position.set(8.5, 7.2, 11.5);
    camera.lookAt(0, 0, 0);

    const root = new THREE.Group();
    root.rotation.x = -0.08;
    scene.add(root);

    const board = new THREE.Mesh(
      new THREE.BoxGeometry(11.6, 0.28, 7.2),
      new THREE.MeshStandardMaterial({ color: 0x11161a, metalness: 0.72, roughness: 0.42 }),
    );
    board.position.y = -0.32;
    root.add(board);

    const modules: THREE.Mesh[] = [];
    const moduleGeometry = new THREE.BoxGeometry(0.74, 0.32, 0.74);
    const moduleMaterial = new THREE.MeshStandardMaterial({ color: 0x33e0c1, metalness: 0.46, roughness: 0.32 });
    for (let row = 0; row < 6; row += 1) {
      for (let column = 0; column < 9; column += 1) {
        if ((row === 1 || row === 4) && column > 2 && column < 6) continue;
        const module = new THREE.Mesh(moduleGeometry, moduleMaterial.clone());
        module.position.set((column - 4) * 1.06, 0, (row - 2.5) * 1.03);
        module.scale.y = 0.55 + ((column + row) % 4) * 0.22;
        module.position.y = module.scale.y * 0.18;
        modules.push(module);
        root.add(module);
      }
    }

    const traces = new THREE.Group();
    const traceMaterial = new THREE.LineBasicMaterial({ color: 0x5bf0d1, transparent: true, opacity: 0.34 });
    for (let row = 0; row < 7; row += 1) {
      const points = [new THREE.Vector3(-5.2, 0.03, (row - 3) * 1.03), new THREE.Vector3(5.2, 0.03, (row - 3) * 1.03)];
      traces.add(new THREE.Line(new THREE.BufferGeometry().setFromPoints(points), traceMaterial));
    }
    for (let column = 0; column < 11; column += 1) {
      const points = [new THREE.Vector3((column - 5) * 1.03, 0.04, -3.1), new THREE.Vector3((column - 5) * 1.03, 0.04, 3.1)];
      traces.add(new THREE.Line(new THREE.BufferGeometry().setFromPoints(points), traceMaterial));
    }
    root.add(traces);

    const particleCount = 720;
    const positions = new Float32Array(particleCount * 3);
    for (let index = 0; index < particleCount; index += 1) {
      positions[index * 3] = (Math.random() - 0.5) * 16;
      positions[index * 3 + 1] = Math.random() * 7 - 1.5;
      positions[index * 3 + 2] = (Math.random() - 0.5) * 12;
    }
    const particleGeometry = new THREE.BufferGeometry();
    particleGeometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));
    const particleMaterial = new THREE.PointsMaterial({ color: 0x8fffea, size: 0.035, transparent: true, opacity: 0.72 });
    const particles = new THREE.Points(particleGeometry, particleMaterial);
    root.add(particles);

    const cyanLight = new THREE.PointLight(0x4cf6d3, 36, 22);
    cyanLight.position.set(-3, 5, 4);
    scene.add(cyanLight);
    const warmLight = new THREE.PointLight(0xff5a47, 24, 18);
    warmLight.position.set(5, 2, -3);
    scene.add(warmLight);
    scene.add(new THREE.AmbientLight(0x98a8b5, 0.72));

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let visible = true;
    let frame = 0;
    let pointerX = 0;
    let pointerY = 0;
    let temperature = 0;

    const resize = () => {
      const { width, height } = container.getBoundingClientRect();
      if (!width || !height) return;
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 1.6));
      renderer.setSize(width, height, false);
      camera.aspect = width / height;
      camera.updateProjectionMatrix();
      renderer.render(scene, camera);
    };

    const render = (time = 0) => {
      const heroHeight = Math.max(container.closest('section')?.clientHeight ?? window.innerHeight, 1);
      temperature = THREE.MathUtils.clamp(window.scrollY / heroHeight, 0, 1);
      const cool = new THREE.Color(0x35e4c5);
      const hot = new THREE.Color(0xff5a47);
      modules.forEach((module, index) => {
        const pulse = reduceMotion.matches ? 0 : Math.sin(time * 0.0018 + index * 0.37) * 0.08;
        (module.material as THREE.MeshStandardMaterial).color.copy(hot).lerp(cool, temperature + pulse);
      });
      root.rotation.y += (pointerX * 0.18 - root.rotation.y) * 0.035;
      root.rotation.x += (-0.08 + pointerY * 0.08 - root.rotation.x) * 0.035;
      if (!reduceMotion.matches) particles.rotation.y = time * 0.000055;
      cyanLight.intensity = 20 + temperature * 28;
      warmLight.intensity = 36 - temperature * 25;
      renderer.render(scene, camera);
      if (visible && !document.hidden && !reduceMotion.matches) frame = requestAnimationFrame(render);
    };

    const start = () => {
      cancelAnimationFrame(frame);
      if (reduceMotion.matches) render(0);
      else frame = requestAnimationFrame(render);
    };

    const observer = new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      if (visible) start();
      else cancelAnimationFrame(frame);
    });
    observer.observe(container);

    const resizeObserver = new ResizeObserver(resize);
    resizeObserver.observe(container);
    resize();
    start();

    container.addEventListener('pointermove', (event) => {
      const bounds = container.getBoundingClientRect();
      pointerX = ((event.clientX - bounds.left) / bounds.width - 0.5) * 2;
      pointerY = ((event.clientY - bounds.top) / bounds.height - 0.5) * 2;
    });
    document.addEventListener('visibilitychange', start);
    reduceMotion.addEventListener('change', start);
    canvas.addEventListener('webglcontextlost', (event) => {
      event.preventDefault();
      cancelAnimationFrame(frame);
      fallback?.classList.add('is-visible');
    });
    canvas.addEventListener('webglcontextrestored', () => {
      fallback?.classList.remove('is-visible');
      resize();
      start();
    });

    window.addEventListener('pagehide', () => {
      cancelAnimationFrame(frame);
      observer.disconnect();
      resizeObserver.disconnect();
      moduleGeometry.dispose();
      modules.forEach((module) => (module.material as THREE.Material).dispose());
      particleGeometry.dispose();
      particleMaterial.dispose();
      traceMaterial.dispose();
      renderer.dispose();
    }, { once: true });
  });
</script>
