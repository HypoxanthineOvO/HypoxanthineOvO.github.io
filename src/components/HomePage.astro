---
import { ArrowDown, ArrowUpRight, BookOpen, Cpu, Radio, Terminal } from '@lucide/astro';
import { getCollection } from 'astro:content';

import dailyIssues from '../data/wechat-daily.json';
import { localize, projects, researchTimeline, type Locale } from '../data/portfolio';
import BaseLayout from '../layouts/BaseLayout.astro';
import ThermalField from './ThermalField.astro';

interface Props {
  lang?: Locale;
}

const { lang = 'zh' } = Astro.props;
const featuredProjects = projects.filter((project) => project.featured).slice(0, 5);
const wechatArticles = (await getCollection('wechat')).sort((left, right) => right.data.date.valueOf() - left.data.date.valueOf());
const featuredWriting = wechatArticles.filter((entry) => entry.data.featured).slice(0, 3);
const latestIssue = dailyIssues[0];

const copy = lang === 'en'
  ? {
      eyebrow: 'YUNXIANG HE / HYPOXANTHINE',
      title: 'Reframing GPU design at 77 K.',
      intro: 'Researcher and systems builder at ShanghaiTech VSP Lab. I study cryogenic GPU architecture, build agent tooling, and maintain a long-running archive of technical and literary writing.',
      explore: 'Explore the field',
      current: 'Current field',
      currentTitle: 'Evidence to architecture.',
      currentText: 'My current work connects cryogenic evidence, parameter synthesis, GPU workload characterization, and simulation into one reproducible design-space exploration chain.',
      work: 'Selected systems',
      workTitle: 'Tools that keep becoming infrastructure.',
      allWork: 'All work',
      trajectory: 'Research trajectory',
      trajectoryTitle: 'From application accelerators to cryogenic systems.',
      research: 'Research',
      writing: 'WeChat & writing',
      writingTitle: 'Science writing as a second system.',
      daily: 'Latest AI daily issue',
      allWriting: 'Open WeChat archive',
      beyond: 'Beyond systems',
      beyondTitle: 'Literature, teaching, and the games I keep measuring.',
      beyondText: 'Classical poetry, creative writing, course materials, table tennis, and badminton sit beside the engineering work. The archive keeps these threads visible without forcing them into a CV.',
      about: 'About Yunxiang',
    }
  : {
      eyebrow: '贺云翔 / YUNXIANG HE / HYPOXANTHINE',
      title: '在 77 K 重新思考 GPU。',
      intro: '上海科技大学 VSP Lab 研究生、低温 GPU 研究者与系统构建者。我研究 cryogenic GPU architecture，也持续搭建 Agent 工具和科学写作系统。',
      explore: '进入研究场',
      current: '当前研究',
      currentTitle: '从证据走向架构。',
      currentText: '当前工作把低温器件证据、参数合成、GPU workload characterization 与仿真连接成一条可复现的设计空间探索链。',
      work: '代表系统',
      workTitle: '有些工具，最后会长成基础设施。',
      allWork: '查看全部项目',
      trajectory: '研究轨迹',
      trajectoryTitle: '从应用加速器走向低温计算系统。',
      research: '进入研究页',
      writing: '公众号与写作',
      writingTitle: '把科学写作也做成一套系统。',
      daily: '最新一期 AI 日报',
      allWriting: '进入公众号档案',
      beyond: '系统之外',
      beyondTitle: '文学、教学，以及被持续测量的球场。',
      beyondText: '古典诗词、创意写作、课程材料、乒乓球和羽毛球与工程项目并列存在。这个档案保留这些切面，而不把它们压缩成一份简历。',
      about: '关于贺云翔',
    };
---

<BaseLayout lang={lang} home title={undefined} description={copy.intro} image="/media/projects/hypo-workflow.webp">
  <section class="home-hero">
    <ThermalField />
    <div class="home-hero__veil"></div>
    <div class="home-hero__content">
      <p class="instrument-label">{copy.eyebrow}</p>
      <h1>{copy.title}</h1>
      <p class="home-hero__intro">{copy.intro}</p>
      <div class="hero-readout" aria-label={lang === 'en' ? 'Research status' : '研究状态'}>
        <span><i class="status-dot"></i> 77 K</span>
        <span>GPU ARCHITECTURE</span>
        <span>ACTIVE / 2026</span>
      </div>
      <a class="hero-scroll" href="#current-field">
        <span>{copy.explore}</span>
        <ArrowDown size={18} stroke-width={1.8} aria-hidden="true" />
      </a>
    </div>
    <div class="thermal-scale" aria-hidden="true"><span>300 K</span><b></b><span>77 K</span></div>
  </section>

  <section id="current-field" class="content-band content-band--light current-field">
    <div class="page-shell current-field__grid">
      <div>
        <p class="instrument-label instrument-label--dark">01 / {copy.current}</p>
        <h2>{copy.currentTitle}</h2>
      </div>
      <div>
        <p class="lead-copy">{copy.currentText}</p>
        <dl class="research-chain">
          <div><dt>INPUT</dt><dd>Evidence at 77 K</dd></div>
          <div><dt>MODEL</dt><dd>Parameter synthesis</dd></div>
          <div><dt>SYSTEM</dt><dd>GPU simulation</dd></div>
          <div><dt>OUTPUT</dt><dd>Design space</dd></div>
        </dl>
      </div>
    </div>
  </section>

  <section class="content-band content-band--ink">
    <div class="page-shell">
      <div class="section-intro section-intro--inverse">
        <div><p class="instrument-label">02 / {copy.work}</p><h2>{copy.workTitle}</h2></div>
        <a class="text-link" href={lang === 'en' ? '/en/work' : '/work'}>{copy.allWork}<ArrowUpRight size={17} aria-hidden="true" /></a>
      </div>
      <div class="featured-work">
        {featuredProjects.map((project, index) => (
          <a class:list={['featured-work__item', project.image && 'has-image']} href={project.url ?? '/work'} target={project.url?.startsWith('http') ? '_blank' : undefined} rel="noreferrer">
            {project.image && <img src={project.image} alt="" width="1600" height="900" loading="lazy" />}
            <div class="featured-work__shade"></div>
            <div class="featured-work__content">
              <span class="work-index">0{index + 1}</span>
              <div><p>{localize(project.label, lang)}</p><h3>{project.name}</h3><span>{localize(project.description, lang)}</span></div>
              <ArrowUpRight size={21} aria-hidden="true" />
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="content-band content-band--signal">
    <div class="page-shell research-home">
      <div class="section-intro">
        <div><p class="instrument-label instrument-label--dark">03 / {copy.trajectory}</p><h2>{copy.trajectoryTitle}</h2></div>
        <a class="text-link text-link--dark" href={lang === 'en' ? '/en/research' : '/research'}>{copy.research}<ArrowUpRight size={17} aria-hidden="true" /></a>
      </div>
      <div class="trajectory-list">
        {researchTimeline.map((entry, index) => (
          <article><span>0{index + 1}</span><p>{entry.period}</p><h3>{localize(entry.title, lang)}</h3><div>{localize(entry.text, lang)}</div></article>
        ))}
      </div>
    </div>
  </section>

  <section class="content-band content-band--paper">
    <div class="page-shell">
      <div class="section-intro">
        <div><p class="instrument-label instrument-label--dark">04 / {copy.writing}</p><h2>{copy.writingTitle}</h2></div>
        <a class="text-link text-link--dark" href="/wechat">{copy.allWriting}<ArrowUpRight size={17} aria-hidden="true" /></a>
      </div>
      <div class="writing-feature">
        <a class="daily-preview" href={`/wechat/daily/${latestIssue.date}`}>
          <img src={latestIssue.cover ?? '/media/projects/ai-daily.webp'} alt="" width="1536" height="864" loading="lazy" />
          <div><p class="instrument-label">{copy.daily} / {latestIssue.date}</p><h3>{latestIssue.title}</h3><span>{latestIssue.items.length} NEWS ITEMS</span></div>
        </a>
        <div class="essay-preview-list">
          {featuredWriting.map((entry) => (
            <a href={`/wechat/articles/${entry.id}`}>
              <span>{entry.data.series}</span>
              <h3>{entry.data.title}</h3>
              <p>{entry.data.description}</p>
              <ArrowUpRight size={18} aria-hidden="true" />
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="content-band content-band--light">
    <div class="page-shell beyond-grid">
      <img src="/media/profile/yunxiang-he.webp" alt={lang === 'en' ? 'Yunxiang He' : '贺云翔'} width="480" height="480" />
      <div>
        <p class="instrument-label instrument-label--dark">05 / {copy.beyond}</p>
        <h2>{copy.beyondTitle}</h2>
        <p class="lead-copy">{copy.beyondText}</p>
        <div class="beyond-signals"><span><BookOpen size={18} /> POETRY</span><span><Terminal size={18} /> TEACHING</span><span><Radio size={18} /> WRITING</span><span><Cpu size={18} /> SYSTEMS</span></div>
        <a class="button-link" href={lang === 'en' ? '/en/about' : '/about'}>{copy.about}<ArrowUpRight size={17} aria-hidden="true" /></a>
      </div>
    </div>
  </section>
</BaseLayout>
