---
import '@fontsource-variable/inter/wght.css';
import '@fontsource/noto-serif-sc/400.css';
import '@fontsource/noto-serif-sc/700.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/600.css';

import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import '../styles/global.css';
import { siteConfig } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  lang?: 'zh' | 'en';
  image?: string;
  home?: boolean;
}

const {
  title,
  description = siteConfig.description,
  lang = 'zh',
  image = '/media/projects/ai-daily.webp',
  home = false,
} = Astro.props;
const pageTitle = title ? `${title} | ${siteConfig.title}` : siteConfig.title;
const canonical = new URL(Astro.url.pathname, siteConfig.site);
const alternatePath = lang === 'en' ? Astro.url.pathname.replace(/^\/en/, '') || '/' : Astro.url.pathname === '/' ? '/en' : `/en${Astro.url.pathname}`;
const themeScript = `
(() => {
  const stored = localStorage.getItem('hypo-theme');
  const dark = stored ? stored === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
  document.documentElement.classList.toggle('dark', dark);
})();
`;
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Yunxiang He',
  alternateName: ['贺云翔', 'Hypoxanthine'],
  url: siteConfig.site,
  affiliation: { '@type': 'Organization', name: 'ShanghaiTech University VSP Lab' },
  sameAs: [siteConfig.github],
};
---

<!doctype html>
<html lang={lang === 'en' ? 'en' : 'zh-CN'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content={siteConfig.author} />
    <meta name="theme-color" content="#090b0d" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={lang === 'en' ? 'zh-CN' : 'en'} href={new URL(alternatePath, siteConfig.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL('/', siteConfig.site)} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={siteConfig.title} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, siteConfig.site)} />
    <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'zh_CN'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{pageTitle}</title>
    <script is:inline set:html={themeScript} />
    {home && <script type="application/ld+json" is:inline set:html={JSON.stringify(personSchema)} />}
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">{lang === 'en' ? 'Skip to content' : '跳到主要内容'}</a>
    <Header lang={lang} />
    <main id="main-content" class:list={[home ? 'page-main page-main--home' : 'page-main']}>
      <slot />
    </main>
    <Footer />
  </body>
</html>
